local function board(x, z, text)
	for _, dx in ipairs({ -7, 7 }) do P(map, "BoardPost", Vector3.new(1, 7, 1), CFrame.new(x + dx, 3.5, z), WOOD2) end
	local b = P(map, "Board", Vector3.new(16, 9, 1), CFrame.new(x, 8.5, z), Color3.fromRGB(255, 244, 214))
	local sg = Instance.new("SurfaceGui")
	sg.Face, sg.CanvasSize, sg.Parent = Enum.NormalId.Back, Vector2.new(800, 450), b
	local t = Instance.new("TextLabel")
	t.Size, t.BackgroundTransparency, t.Text, t.TextScaled = UDim2.new(1, -30, 1, -30), 1, text, true
	t.Position, t.Font, t.TextColor3 = UDim2.new(0, 15, 0, 15), Enum.Font.FredokaOne, Color3.fromRGB(80, 52, 28)
	t.Parent = sg
	return t
end
