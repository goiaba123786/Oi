	end
end

-- ===== estado / dados =====
local function count() local n = 0 for _ in pairs(alive) do n = n + 1 end return n end
local function okChar(p)
	local c = p.Character
	local h = c and c:FindFirstChildOfClass("Humanoid")
	return h and h.Health > 0 and c:FindFirstChild("HumanoidRootPart") ~= nil
end
local function aliveList()
	local t = {}
	for p in pairs(alive) do if okChar(p) then t[#t + 1] = p end end
	return t
end
local function payload()
	local a = currentArena or nextArena
	return { Phase = phase, Text = status, Alive = count(), Holder = holder and holder.DisplayName or "", Arena = a and a.Name or "", BombEnd = holder and (workspace:GetServerTimeNow() + (bombEnd - os.clock())) or 0 }
end
local function push() rState:FireAllClients(payload()) end
local function msg(t, color) rMsg:FireAllClients(t, color) end

local store
pcall(function() store = DSS:GetDataStore("PassaBomba_v2") end)
local PD = {}
local function stat(p, name, delta)
	if isBot(p) then return end
	local ls = p:FindFirstChild("leaderstats")
	local v = ls and ls:FindFirstChild(name)
	if v then v.Value = v.Value + delta end
end
local function pushSkins(p)
	local pd = PD[p]
	if pd then rSkinState:FireClient(p, { Owned = pd.Owned, Equipped = pd.Equipped, Burgers = pd.Burgers or 0 }) end
end
local function save(p)
	local ls, pd = p:FindFirstChild("leaderstats"), PD[p]
	if store and ls and pd then
		pcall(function()
			store:SetAsync("u" .. p.UserId, { Wins = ls.Wins.Value, Coins = ls.Coins.Value, Owned = pd.Owned, Equipped = pd.Equipped, Receipts = pd.ReceiptList, Burgers = pd.Burgers })
		end)
	end
end
local function onJoin(p)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local wins, coins = Instance.new("IntValue"), Instance.new("IntValue")
	wins.Name, coins.Name = "Wins", "Coins"
	wins.Parent, coins.Parent = ls, ls
	local pd = { Owned = { classic = true }, Equipped = "classic", Receipts = {}, ReceiptList = {}, Burgers = 0 }
	if store then
		local ok, v = pcall(function() return store:GetAsync("u" .. p.UserId) end)
		if ok and type(v) == "table" then
			wins.Value, coins.Value = v.Wins or 0, v.Coins or 0
			pd.Owned = v.Owned or pd.Owned
			pd.Owned.classic = true
			if v.Equipped and pd.Owned[v.Equipped] then pd.Equipped = v.Equipped end
			pd.ReceiptList = v.Receipts or {}
			pd.Burgers = v.Burgers or 0
			for _, rid in ipairs(pd.ReceiptList) do pd.Receipts[rid] = true end
		end
	end
	PD[p] = pd
	ls.Parent = p
	rState:FireClient(p, payload())
	pushSkins(p)
end
Players.PlayerAdded:Connect(onJoin)
for _, p in ipairs(Players:GetPlayers()) do task.spawn(onJoin, p) end
Players.PlayerRemoving:Connect(function(p)
	save(p)
	alive[p] = nil
	PD[p] = nil
end)
game:BindToClose(function() for _, p in ipairs(Players:GetPlayers()) do save(p) end end)

-- skins: equipar / comprar com moedas / comprar com Robux
rSkinAct.OnServerEvent:Connect(function(p, action, id)
	local pd = PD[p]
	if action == "pack" then
		local pk = type(id) == "string" and PackBy[id]
		if not pd or not pk then return end
		if not pk.ProductId or pk.ProductId == 0 then
			rMsg:FireClient(p, "Cole o ProductId deste pacote no PBConfig", Color3.fromRGB(255, 200, 80))
			return
		end
		pcall(function() MPS:PromptProductPurchase(p, pk.ProductId) end)
		return
	end
	if action == "burger" then
		local ls = p:FindFirstChild("leaderstats")
		if not pd or not ls then return end
		if not alive[p] or phase ~= "playing" then
			rMsg:FireClient(p, "Compre o hamburguer durante a partida!", Color3.fromRGB(255, 200, 80))
			return
		end
		if ls.Coins.Value < CFG.BurgerCoins then
			rMsg:FireClient(p, "Moedas insuficientes", Color3.fromRGB(255, 120, 100))
			return
		end
		ls.Coins.Value = ls.Coins.Value - CFG.BurgerCoins
		boost[p] = { Until = os.clock() + CFG.BurgerTime, Mult = CFG.BurgerMult }
		rMsg:FireClient(p, "Hamburguer! Velocidade extra por " .. CFG.BurgerTime .. "s", Color3.fromRGB(255, 200, 80))
		return
	elseif action == "eatduplo" then
		if not pd or (pd.Burgers or 0) <= 0 then return end
		if not alive[p] or phase ~= "playing" then
			rMsg:FireClient(p, "Coma durante a partida!", Color3.fromRGB(255, 200, 80))
			return
		end
		pd.Burgers = pd.Burgers - 1
		boost[p] = { Until = os.clock() + CFG.DoubleTime, Mult = CFG.DoubleMult }
		pushSkins(p)
		rMsg:FireClient(p, "Hamburguer DUPLO! Super velocidade por " .. CFG.DoubleTime .. "s", Color3.fromRGB(255, 160, 60))
		return
	elseif action == "buyduplo" then
		local bp = CF.BurgerPack
		if not pd then return end
		if not bp.ProductId or bp.ProductId == 0 then
			rMsg:FireClient(p, "Cole o ProductId do combo no PBConfig", Color3.fromRGB(255, 200, 80))
			return
		end
		pcall(function() MPS:PromptProductPurchase(p, bp.ProductId) end)
		return
	end
	local s = type(id) == "string" and SkinBy[id]
	if not pd or not s then return end
	if action == "equip" then
		if pd.Owned[id] then
			pd.Equipped = id
			pushSkins(p)
		end
	elseif action == "coins" then
		local ls = p:FindFirstChild("leaderstats")
		if pd.Owned[id] or not s.Coins or not ls then return end
		if ls.Coins.Value < s.Coins then
			rMsg:FireClient(p, "Moedas insuficientes", Color3.fromRGB(255, 120, 100))
			return
		end
		ls.Coins.Value = ls.Coins.Value - s.Coins
		pd.Owned[id], pd.Equipped = true, id
		save(p)
		pushSkins(p)
		rMsg:FireClient(p, "Skin " .. s.Name .. " comprada!", Color3.fromRGB(120, 255, 140))
	elseif action == "robux" then
		if pd.Owned[id] or not s.Robux then return end
		if not s.ProductId or s.ProductId == 0 then
			rMsg:FireClient(p, "Cole o ProductId desta skin no PBConfig", Color3.fromRGB(255, 200, 80))
			return
		end
		pcall(function() MPS:PromptProductPurchase(p, s.ProductId) end)
	end
end)
local productSkin = {}
for _, s in ipairs(CF.Skins) do
	if s.ProductId and s.ProductId > 0 then productSkin[s.ProductId] = s end
end
local productPack = {}
for _, k in ipairs(CF.CoinPacks) do
	if k.ProductId and k.ProductId > 0 then productPack[k.ProductId] = k end
end
MPS.ProcessReceipt = function(info)
	local p = Players:GetPlayerByUserId(info.PlayerId)
	local pd = p and PD[p]
	if not pd then return Enum.ProductPurchaseDecision.NotProcessedYet end
	local rid = tostring(info.PurchaseId)
	if pd.Receipts[rid] then return Enum.ProductPurchaseDecision.PurchaseGranted end
	local s, pk = productSkin[info.ProductId], productPack[info.ProductId]
	local bg = CF.BurgerPack.ProductId and CF.BurgerPack.ProductId > 0 and info.ProductId == CF.BurgerPack.ProductId
	if not s and not pk and not bg then return Enum.ProductPurchaseDecision.NotProcessedYet end
	pd.Receipts[rid] = true
	pd.ReceiptList[#pd.ReceiptList + 1] = rid
	if #pd.ReceiptList > 100 then
		local oldId = table.remove(pd.ReceiptList, 1)
		pd.Receipts[oldId] = nil
	end
	if s then
		pd.Owned[s.Id], pd.Equipped = true, s.Id
		pushSkins(p)
		rMsg:FireClient(p, "Skin " .. s.Name .. " comprada!", Color3.fromRGB(120, 255, 140))
	elseif bg then
		pd.Burgers = (pd.Burgers or 0) + CF.BurgerPack.Count
		pushSkins(p)
		rMsg:FireClient(p, "+" .. CF.BurgerPack.Count .. " hamburgueres duplos!", Color3.fromRGB(255, 200, 80))
	else
		stat(p, "Coins", pk.Coins)
		rMsg:FireClient(p, "+" .. pk.Coins .. " moedas!", Color3.fromRGB(255, 220, 80))
	end
	save(p)
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

-- ===== lobby interativo =====
local function addPrompt(part, action, obj, cb)
	local pr = Instance.new("ProximityPrompt")
	pr.ActionText, pr.ObjectText, pr.MaxActivationDistance, pr.HoldDuration, pr.RequiresLineOfSight = action, obj, 12, 0, false
	pr.Style = Enum.ProximityPromptStyle.Custom -- UI pequena feita no cliente
	pr.Parent = part
	pr.Triggered:Connect(cb)
end
addPrompt(skinCounter, "Abrir", "Loja de Skins", function(p) rOpenUI:FireClient(p, "skins") end)
addPrompt(coinCounter, "Abrir", "Loja de Moedas", function(p) rOpenUI:FireClient(p, "coins") end)
addPrompt(botCounter, "Jogar", "Partida com Bots", function(p) rOpenUI:FireClient(p, "bots") end)
if chefNPC then
	addPrompt(chefNPC.PrimaryPart, "Comprar hamburguer", "Chef Pierre", function(p) rOpenUI:FireClient(p, "chef") end)
	RunS.Heartbeat:Connect(function()
		if chefAnimate then chefAnimate(os.clock()) end
	end)
end

local petsFolder = Instance.new("Folder")
petsFolder.Name = "CapyPets"
petsFolder.Parent = workspace
local followers = {}
local function ensureFollower(p)
	local pd = PD[p]
	if not pd or not pd.Owned.capybara then return end
	local m = followers[p]
	if m and m.Parent then return end
	m = makeCapy(0.5)
	m.Name = "CapyPet"
	m.Parent = petsFolder
	followers[p] = m
end
addPrompt(capyNPC.PrimaryPart, "Pegar skin gratis", "Capivara", function(p)
	local pd = PD[p]
	if not pd then return end
	if pd.Owned.capybara then
		rMsg:FireClient(p, "Voce ja tem a skin Capivara!", Color3.fromRGB(255, 220, 120))
		return
	end
	pd.Owned.capybara, pd.Equipped = true, "capybara"
	save(p)
	pushSkins(p)
	ensureFollower(p)
	rMsg:FireClient(p, "A capivara te deu a skin Capivara de graca!", Color3.fromRGB(120, 255, 140))
end)

local capyBase = capyNPC:GetPivot()
RunS.Heartbeat:Connect(function()
	capyNPC:PivotTo(capyBase * CFrame.new(0, math.abs(math.sin(os.clock() * 2)) * 0.3, 0) * CFrame.Angles(0, math.sin(os.clock()) * 0.15, 0))
	for p, m in pairs(followers) do
		local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
		if hrp and m.Parent then
			local bob = math.sin(os.clock() * 6) * 0.15
			m:PivotTo(m:GetPivot():Lerp(hrp.CFrame * CFrame.new(3.5, -1.85 + bob, 3.5), 0.15))
		end
	end
end)
Players.PlayerRemoving:Connect(function(p)
	if followers[p] then
		followers[p]:Destroy()
		followers[p] = nil
	end
end)
task.spawn(function()
	while true do
		for _, p in ipairs(Players:GetPlayers()) do ensureFollower(p) end
		task.wait(3)
	end
end)
task.spawn(function()
	while true do
		local rows = {}
		for _, p in ipairs(Players:GetPlayers()) do
			local ls = p:FindFirstChild("leaderstats")
			if ls then rows[#rows + 1] = { p.DisplayName, ls.Wins.Value } end
		end
		table.sort(rows, function(x, y) return x[2] > y[2] end)
		local lines = { "RANKING DE VITORIAS" }
		for i = 1, math.min(5, #rows) do lines[#lines + 1] = i .. ". " .. rows[i][1] .. "  -  " .. rows[i][2] end
		rankLabel.Text = table.concat(lines, "\n")
		task.wait(5)
	end
end)

-- ===== bomba =====
local function clearBomb()
	for _, c in ipairs(conns) do c:Disconnect() end
	conns = {}
	if holder then
		holder:SetAttribute("HasBomb", false)
		local ch = holder.Character
		local b = ch and ch:FindFirstChild("Bomb")
		if b then b:Destroy() end
		local h = ch and ch:FindFirstChildOfClass("Humanoid")
		if h then h.WalkSpeed = isBot(holder) and CFG.BotNormalSpeed or CFG.NormalSpeed end
	end
	holder, bombPart, holderSkin = nil, nil, nil
end

local giveBomb
local function onTouch(hit)
	if not holder or os.clock() < passLock then return end
	local model = hit:FindFirstAncestorOfClass("Model")
	local other = model and (Players:GetPlayerFromCharacter(model) or botByModel[model])
	if other and other ~= holder and alive[other] and okChar(other) then
		passLock = os.clock() + CFG.PassCooldown
		local from = holder
		giveBomb(other)
		msg(from.DisplayName .. " passou a bomba para " .. other.DisplayName .. "!", Color3.fromRGB(255, 200, 80))
	end
end

giveBomb = function(p)
	clearBomb()
	holder = p
	p:SetAttribute("HasBomb", true)
	local ch = p.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	local head = ch and ch:FindFirstChild("Head")
	if not hum or not head then return end
	hum.WalkSpeed = isBot(p) and CFG.BotHolderSpeed or CFG.HolderSpeed
	local sid = isBot(p) and p.Skin or (PD[p] and PD[p].Equipped) or "classic"
	local skin = SkinBy[sid] or CF.Skins[1]
	holderSkin = skin
	local m = Instance.new("Model")
	m.Name = "Bomb"
	local b = Instance.new("Part")
	b.Name, b.Shape, b.Size, b.Color = "Body", Enum.PartType.Ball, Vector3.new(2.6, 2.6, 2.6), skin.Base
	b.Material, b.CanCollide, b.Massless, b.CFrame = skin.Mat or Enum.Material.SmoothPlastic, false, true, head.CFrame * CFrame.new(0, 3, 0)
	b.Parent = m
	local f = Instance.new("Part")
	f.Name, f.Size, f.Color, f.CanCollide, f.Massless = "Fuse", Vector3.new(0.35, 1, 0.35), skin.Fuse or Color3.fromRGB(170, 120, 60), false, true
	f.CFrame = b.CFrame * CFrame.new(0, 1.6, 0)
	f.Parent = m
	local w1 = Instance.new("WeldConstraint")
	w1.Part0, w1.Part1, w1.Parent = head, b, b
	local w2 = Instance.new("WeldConstraint")
	w2.Part0, w2.Part1, w2.Parent = b, f, f
	local spk = Instance.new("Sparkles")
	spk.SparkleColor = Color3.fromRGB(255, 170, 40)
	spk.Parent = f
	if skin.Effect == "fire" then
		local fire = Instance.new("Fire")
		fire.Size, fire.Heat, fire.Color, fire.SecondaryColor = 6, 8, skin.Flash, skin.Base
		fire.Parent = b
	elseif skin.Effect == "sparkles" then
		local s2 = Instance.new("Sparkles")
		s2.SparkleColor = skin.Flash
		s2.Parent = b
	end
	local function dec(size, cf, color, mat, shape)
		local d = Instance.new("Part")
		d.Size, d.Color, d.Material, d.CanCollide, d.Massless = size, color, mat or PLASTIC, false, true
		if shape then d.Shape = shape end
		d.CFrame = b.CFrame * cf
		d.Parent = m
		local w = Instance.new("WeldConstraint")
		w.Part0, w.Part1, w.Parent = b, d, d
	end
	local acc = skin.Accent or Color3.new(1, 1, 1)
	if skin.Pattern == "stripes" then
		for i = 0, 2 do dec(Vector3.new(0.18, 2.75, 2.75), CFrame.Angles(0, 0, math.rad(i * 60)), acc, nil, Enum.PartType.Cylinder) end
	elseif skin.Pattern == "dots" or skin.Pattern == "stars" then
		for i = 1, 12 do
			local y = 1 - (i - 0.5) / 6
			local r = math.sqrt(math.max(0, 1 - y * y))
			local th = i * 2.4
			local pos = Vector3.new(math.cos(th) * r, y, math.sin(th) * r) * 1.25
			if skin.Pattern == "dots" then
				dec(Vector3.new(0.5, 0.5, 0.5), CFrame.new(pos), acc, nil, Enum.PartType.Ball)
			else
				dec(Vector3.new(0.6, 0.6, 0.15), CFrame.lookAt(pos, pos * 2) * CFrame.Angles(0, 0, math.rad(45)), acc, Enum.Material.Neon)
			end
		end
	elseif skin.Pattern == "skull" then
		for _, sx in ipairs({ -0.45, 0.45 }) do dec(Vector3.new(0.5, 0.6, 0.2), CFrame.new(sx, 0.25, -1.2), acc) end
		dec(Vector3.new(0.25, 0.35, 0.2), CFrame.new(0, -0.15, -1.25), acc)
		for i = -2, 2 do dec(Vector3.new(0.12, 0.35, 0.2), CFrame.new(i * 0.26, -0.6, -1.15), acc) end
	end
	-- mini contador acima da bomba (o cliente atualiza o texto)
	local bbg = Instance.new("BillboardGui")
	bbg.Size, bbg.StudsOffset, bbg.AlwaysOnTop = UDim2.new(0, 54, 0, 22), Vector3.new(0, 2.6, 0), true
	bbg.Parent = b
	local tl = Instance.new("TextLabel")
	tl.Name, tl.Size, tl.BackgroundColor3, tl.BackgroundTransparency = "T", UDim2.new(1, 0, 1, 0), Color3.new(0, 0, 0), 0.35
	tl.TextColor3, tl.Font, tl.TextScaled, tl.Text = Color3.new(1, 1, 1), Enum.Font.FredokaOne, true, ""
	tl.Parent = bbg
	local tc = Instance.new("UICorner")
	tc.CornerRadius = UDim.new(0, 8)
	tc.Parent = tl
	b:SetAttribute("EndT", workspace:GetServerTimeNow() + (bombEnd - os.clock()))
	CS:AddTag(b, "PBBomb")
	m.Parent = ch
	bombPart = b
	for _, d in ipairs(ch:GetDescendants()) do
		if d:IsA("BasePart") then conns[#conns + 1] = d.Touched:Connect(onTouch) end
	end
	push()
end

local lastOn = nil
RunS.Heartbeat:Connect(function()
	if holder and bombPart and bombPart.Parent and holderSkin then
		local frac = 1 - math.clamp((bombEnd - os.clock()) / bombTotal, 0, 1)
		local on = math.sin(os.clock() * (3 + frac * 18)) > 0
		if holderSkin.Rainbow then
			bombPart.Color = Color3.fromHSV((os.clock() * 0.5) % 1, 0.9, on and 1 or 0.45)
		end
		if on ~= lastOn then
			lastOn = on
			if not holderSkin.Rainbow then bombPart.Color = on and holderSkin.Flash or holderSkin.Base end
			bombPart.Material = on and Enum.Material.Neon or (holderSkin.Mat or Enum.Material.SmoothPlastic)
		end
	end
end)

eliminate = function(p, why)
	if not alive[p] then return end
	alive[p] = nil
	local ch = p.Character
	local h = ch and ch:FindFirstChildOfClass("Humanoid")
	if p == holder then clearBomb() end
	if h then h.Health = 0 end
	msg(p.DisplayName .. why, Color3.fromRGB(255, 80, 60))
	push()
end

local function explode(p)
	local ch = p.Character
	local pos = bombPart and bombPart.Position or (ch and ch:GetPivot().Position) or Vector3.new()
	local ex = Instance.new("Explosion")
	ex.Position, ex.BlastPressure, ex.BlastRadius, ex.DestroyJointRadiusPercent = pos, 150000, 14, 0
	ex.Parent = workspace
	eliminate(p, " explodiu!")
end

-- ===== atmosfera, Taco Event e Natal =====
local EV = CF.Events

local atm = Instance.new("Atmosphere")
atm.Name, atm.Offset, atm.Parent = "PB_Atmosphere", 0.2, Lighting
local cc = Instance.new("ColorCorrectionEffect")
cc.Name, cc.Parent = "PB_CC", Lighting
local bloom = Instance.new("BloomEffect")
bloom.Name, bloom.Size, bloom.Threshold, bloom.Parent = "PB_Bloom", 24, 1.6, Lighting
Lighting.GlobalShadows = true
local MOODS = {
	day = { Ambient = Color3.fromRGB(70, 70, 70), Outdoor = Color3.fromRGB(110, 110, 110), Density = 0.15, Haze = Color3.fromRGB(199, 199, 199), Tint = Color3.new(1, 1, 1), Bloom = 0.1, Brightness = 2 },
	park = { Ambient = Color3.fromRGB(95, 85, 80), Outdoor = Color3.fromRGB(135, 120, 110), Density = 0.2, Haze = Color3.fromRGB(255, 214, 170), Tint = Color3.fromRGB(255, 244, 228), Bloom = 0.35, Brightness = 2.4, Clock = 17.6 },
	xmas = { Ambient = Color3.fromRGB(60, 72, 105), Outdoor = Color3.fromRGB(95, 110, 150), Density = 0.42, Haze = Color3.fromRGB(190, 205, 235), Tint = Color3.fromRGB(225, 236, 255), Bloom = 0.5, Brightness = 1.6, Clock = 20 },
}
local function applyMood(name, clock)
	local m = MOODS[name] or MOODS.day
	Lighting.ClockTime = clock or m.Clock or 14
	Lighting.Ambient, Lighting.OutdoorAmbient, Lighting.Brightness = m.Ambient, m.Outdoor, m.Brightness
	atm.Density, atm.Color = m.Density, m.Haze
	cc.TintColor = m.Tint
	bloom.Intensity = m.Bloom
end
local function setScene(a)
	local name = "day"
	if xmasActive and (a == nil or a == parkArena) then
		name = "xmas"
	elseif a == parkArena then
		name = "park"
	end
	applyMood(name, (name == "day") and (a and a.Clock or 14) or nil)
end
applyMood("day")

-- ===== TACO EVENT (a cada 10 min). Os tacos sao desenhados no cliente (suave e leve); o servidor so decide posicao e coleta =====
local rTaco = Instance.new("RemoteEvent")
rTaco.Name, rTaco.Parent = "Taco", R
local tacoLive = false

local function eventArea()
	if currentArena and phase == "playing" then return currentArena.Center, 48 end
	return Vector3.new(0, 0, 0), 64
end
local function tacoPos(rec, now)
	local t = now - rec.born
	if t >= rec.fall then return Vector3.new(rec.x, 1.4, rec.z) end
	local p = t / rec.fall
	return Vector3.new(rec.x, 80 - 78.6 * p * p, rec.z)
end
local function runTaco()
	tacoLive = true
	R:SetAttribute("TacoLive", true)
	R:SetAttribute("TacoEnd", workspace:GetServerTimeNow() + EV.TacoDuration)
	rBanner:FireAllClients("TACO EVENT STARTED!", Color3.fromRGB(255, 200, 60), 5)
	rSfx:FireAllClients("taco")
	local list, counts, nextId, acc = {}, {}, 0, 0
	local t0 = os.clock()
	while os.clock() - t0 < EV.TacoDuration do
		local dt = task.wait(0.15)
		local now = workspace:GetServerTimeNow()
		acc = acc + dt * EV.TacoRate
		while acc >= 1 do
			acc = acc - 1
			local center, half = eventArea()
			nextId = nextId + 1
			local rec = {
				id = nextId,
				x = center.X + (math.random() * 2 - 1) * half,
				z = center.Z + (math.random() * 2 - 1) * half,
				fall = 2.2 + math.random() * 1.1,
				born = now + 0.2,
				taken = false,
			}
			list[#list + 1] = rec
			rTaco:FireAllClients("spawn", rec.id, rec.x, rec.z, rec.fall, rec.born)
		end
		for i = #list, 1, -1 do
			local rec = list[i]
			if rec.taken or now - rec.born > rec.fall + 9 then
				table.remove(list, i)
			elseif now - rec.born > rec.fall * 0.7 then
				local pos = tacoPos(rec, now)
				for _, p in ipairs(Players:GetPlayers()) do
					local ch = p.Character
					local hum = ch and ch:FindFirstChildOfClass("Humanoid")
					local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
					if hum and hum.Health > 0 and hrp and (counts[p] or 0) < EV.TacoMaxPerPlayer then
						local dx, dz = hrp.Position.X - rec.x, hrp.Position.Z - rec.z
						if dx * dx + dz * dz < 20 and hrp.Position.Y < pos.Y + 6 and hrp.Position.Y > pos.Y - 8 then
							rec.taken = true
							counts[p] = (counts[p] or 0) + 1
							stat(p, "Coins", EV.TacoCoins)
							rTaco:FireAllClients("take", rec.id)
							rSfx:FireClient(p, "pick")
							break
						end
					end
				end
			end
		end
	end
	tacoLive = false
	R:SetAttribute("TacoLive", false)
end
task.spawn(function()
	while true do
		local at = workspace:GetServerTimeNow() + EV.TacoInterval
		R:SetAttribute("TacoAt", at)
		R:SetAttribute("TacoLive", false)
		while workspace:GetServerTimeNow() < at do task.wait(0.5) end
		runTaco() -- ao terminar, o laco recomeca a contagem de 10 minutos
	end
end)

-- ===== NATAL =====
local xmasFolder, lobbyXmas, santaConn
local saved = {}
local function snowColor(c) return c:Lerp(Color3.new(1, 1, 1), 0.82) end
local function recolor(p)
	saved[p] = p.Color
	p.Color = snowColor(p.Color)
end

local function xtree(parent, origin, x, z, scale, lit)
	local function XP(nm, size, off, col, mat) return P(parent, nm, size, CFrame.new(origin + off), col, mat) end
	XP("XTrunk", Vector3.new(1.6 * scale, 2 * scale, 1.6 * scale), Vector3.new(x, scale, z), Color3.fromRGB(110, 75, 40))
	local y = 2 * scale
	for i, t in ipairs({ { 8, 3 }, { 6, 3 }, { 4, 3 }, { 2, 2.5 } }) do
		local w, hh = t[1] * scale, t[2] * scale
		XP("XTree", Vector3.new(w, hh, w), Vector3.new(x, y + hh / 2, z), Color3.fromRGB(18 + i * 8, 110 + i * 12, 50))
		for k = 1, 2 do
			local sgn = (k == 1) and 1 or -1
			local b = XP("XLight", Vector3.new(0.7, 0.7, 0.7), Vector3.new(x + sgn * w / 2, y + hh * 0.55, z + sgn * ((i % 2 == 0) and w / 2 or -w / 2)), Color3.fromHSV((i * 0.23 + k * 0.4) % 1, 0.9, 1), Enum.Material.Neon)
			b.CanCollide, b.CanTouch, b.CanQuery = false, false, false
			CS:AddTag(b, "PBBulb")
		end
		y = y + hh
	end
	local star = XP("XStar", Vector3.new(1.6, 1.6, 1.6), Vector3.new(x, y + 0.8, z), Color3.fromRGB(255, 220, 80), Enum.Material.Neon)
	star.CanCollide = false
	if lit then
		local l = Instance.new("PointLight")
		l.Range, l.Brightness, l.Color, l.Shadows = 18, 1.4, Color3.fromRGB(255, 220, 140), false
		l.Parent = star
	end
end

local function gift(parent, origin, x, z, s, hue)
	local col, rib = Color3.fromHSV(hue, 0.75, 1), Color3.fromHSV((hue + 0.5) % 1, 0.6, 1)
	local at = origin + Vector3.new(x, s / 2, z)
	P(parent, "Gift", Vector3.new(s, s, s), CFrame.new(at), col)
	local r1 = P(parent, "Ribbon", Vector3.new(s + 0.1, s + 0.1, s * 0.25), CFrame.new(at), rib)
	local r2 = P(parent, "Ribbon", Vector3.new(s * 0.25, s + 0.1, s + 0.1), CFrame.new(at), rib)
	local bow = P(parent, "Bow", Vector3.new(s * 0.4, s * 0.25, s * 0.4), CFrame.new(origin + Vector3.new(x, s + s * 0.12, z)), rib, Enum.Material.Neon)
	r1.CanCollide, r2.CanCollide, bow.CanCollide = false, false, false
end

local function makeSanta(parent)
	local V = Vector3.new
	local m = Instance.new("Model")
	m.Name = "Santa"
	m.Parent = parent
	local rig = {}
	local function sp(name, size, x, y, z, col, pvt, anim, mat)
		local p = Instance.new("Part")
		p.Name, p.Size, p.Color, p.Material, p.Anchored, p.CanCollide = name, size, col, mat or PLASTIC, true, false
		p.CanTouch, p.CanQuery = false, false
		for _, f in ipairs(FACES) do p[f] = Enum.SurfaceType.Studs end
		p.Parent = m
		local rest = CFrame.new(x, y, z)
		rig[#rig + 1] = { p = p, rest = rest, pvt = pvt and CFrame.new(pvt) or rest, anim = anim }
		return p
	end
	local RED, WHITE, SKIN, BLACK = Color3.fromRGB(205, 30, 40), Color3.new(1, 1, 1), Color3.fromRGB(240, 190, 150), Color3.fromRGB(25, 25, 30)
	local torso = sp("Torso", V(3.6, 3.8, 2.2), 0, 6.1, 0, RED)
	sp("Belly", V(3.7, 1.6, 0.3), 0, 5.6, -1.2, WHITE)
	sp("Belt", V(3.8, 0.6, 2.4), 0, 5, 0, BLACK)
	sp("Buckle", V(1, 0.8, 0.2), 0, 5, -1.25, Color3.fromRGB(255, 205, 50), nil, nil, Enum.Material.Neon)
	for _, s in ipairs({ -1, 1 }) do
		local an = (s < 0) and "legL" or "legR"
		local hip = V(1.0 * s, 4.2, 0)
		sp("Pants", V(1.5, 2.6, 1.6), 1.0 * s, 2.9, 0, RED, hip, an)
		sp("Boot", V(1.6, 1.1, 2.2), 1.0 * s, 0.55, -0.3, BLACK, hip, an)
		local arm = (s < 0) and "armL" or "armR"
		local sh = V(2.3 * s, 7.6, 0)
		sp("Arm", V(1, 3, 1), 2.3 * s, 6.2, 0, RED, sh, arm)
		sp("Mitten", V(1.1, 1, 1.1), 2.3 * s, 4.4, 0, WHITE, sh, arm)
		sp("Eye", V(0.3, 0.3, 0.2), 0.5 * s, 9.3, -1.12, BLACK)
	end
	sp("Head", V(2.2, 2.2, 2.2), 0, 8.9, 0, SKIN)
	sp("Beard", V(2.4, 1.6, 0.6), 0, 8.2, -1.2, WHITE)
	sp("Mustache", V(1.8, 0.35, 0.4), 0, 8.9, -1.25, WHITE)
	sp("Nose", V(0.45, 0.45, 0.35), 0, 8.8, -1.4, Color3.fromRGB(240, 150, 140))
	sp("HatBrim", V(2.6, 0.6, 2.6), 0, 9.85, 0, WHITE)
	sp("Hat", V(2.5, 1.8, 2.5), 0, 10.8, 0, RED)
	sp("Pom", V(0.9, 0.9, 0.9), 0, 11.9, 0, WHITE)
	sp("Sack", V(2.6, 2.8, 1.8), 0, 6.2, 1.9, Color3.fromRGB(150, 100, 55))
	sp("SackGift", V(0.8, 0.8, 0.8), -0.6, 7.8, 1.9, Color3.fromRGB(60, 140, 230))
	sp("SackGift", V(0.8, 0.8, 0.8), 0.6, 7.8, 1.9, Color3.fromRGB(80, 200, 100))
	local bb = Instance.new("BillboardGui")
	bb.Size, bb.StudsOffset, bb.AlwaysOnTop = UDim2.new(0, 200, 0, 40), Vector3.new(0, 7, 0), true
	bb.Parent = torso
	local say = Instance.new("TextLabel")
	say.Size, say.BackgroundTransparency, say.Text, say.TextScaled = UDim2.new(1, 0, 1, 0), 1, "HO HO HO!", true
	say.Font, say.TextColor3, say.TextStrokeTransparency = Enum.Font.FredokaOne, Color3.new(1, 1, 1), 0
	say.Parent = bb
	local function pose(root, t)
		local ph = t * 5
		local base = root * CFrame.new(0, math.abs(math.sin(ph)) * 0.25, 0)
		for _, r in ipairs(rig) do
			local rot, an = CFrame.new(), r.anim
			if an == "legL" then rot = CFrame.Angles(math.sin(ph) * 0.5, 0, 0)
			elseif an == "legR" then rot = CFrame.Angles(-math.sin(ph) * 0.5, 0, 0)
			elseif an == "armL" then rot = CFrame.Angles(-math.sin(ph) * 0.5, 0, 0)
			elseif an == "armR" then rot = CFrame.Angles(2.3 + math.sin(t * 6) * 0.45, 0, 0) end
			r.p.CFrame = base * r.pvt * rot * r.pvt:Inverse() * r.rest
		end
	end
	return m, pose, say
end

local function xmasOn()
	if xmasActive or not parkArena then return end
	xmasActive = true
	local a = parkArena
	R:SetAttribute("XmasActive", true)
	xmasFolder = Instance.new("Folder")
	xmasFolder.Name = "Christmas"
	xmasFolder.Parent = a.Folder
	local function XP(nm, size, off, col, mat, transp) return P(xmasFolder, nm, size, CFrame.new(a.Center + off), col, mat, transp) end
	local function glow(p) p.CanCollide, p.CanTouch, p.CanQuery = false, false, false CS:AddTag(p, "PBBulb") return p end

	-- neve no chao e nas construcoes
	for _, p in ipairs(a.SnowGround) do recolor(p) end
	for _, e in ipairs(a.SnowCaps) do
		local cf, size, src
		if typeof(e) == "table" then
			cf, size = e.CF, e.Size
		else
			src = e
			cf = e.CFrame * CFrame.new(0, e.Size.Y / 2 + 0.25, 0)
			size = Vector3.new(e.Size.X + 0.2, 0.5, e.Size.Z + 0.2)
		end
		local c = P(xmasFolder, "Snow", size, cf, Color3.new(1, 1, 1))
		c.CanCollide, c.CanTouch, c.CanQuery = false, false, false
		if src and not src.Anchored then
			c.Anchored, c.Massless = false, true
			weld(src, c)
		end
	end
	for _, p in ipairs(a.CenterDecor) do p.Parent = nil end

	-- arvore gigante no centro (os andares sao escalaveis)
	local widths = { 24, 19, 14, 9, 5 }
	for i, w in ipairs(widths) do
		XP("GiantTree", Vector3.new(w, 5, w), Vector3.new(0, (i - 1) * 5 + 2.5, 0), Color3.fromRGB(16 + i * 6, 105 + i * 10, 48))
		local topY = i * 5 - 0.8
		for _, s in ipairs({ -1, 1 }) do
			for _, q in ipairs({ -0.25, 0.25 }) do
				glow(XP("GiantLight", Vector3.new(0.8, 0.8, 0.8), Vector3.new(q * w, topY, s * (w / 2 + 0.2)), Color3.fromHSV((i * 0.17 + q) % 1, 0.9, 1), Enum.Material.Neon))
				glow(XP("GiantLight", Vector3.new(0.8, 0.8, 0.8), Vector3.new(s * (w / 2 + 0.2), topY, q * w), Color3.fromHSV((i * 0.31 + q) % 1, 0.9, 1), Enum.Material.Neon))
			end
		end
		for k, c in ipairs({ { 1, 1 }, { -1, 1 }, { 1, -1 }, { -1, -1 } }) do
			XP("Ornament", Vector3.new(1.4, 1.4, 1.4), Vector3.new(c[1] * (w / 2 + 0.3), i * 5 - 2.5, c[2] * (w / 2 + 0.3)), ({ Color3.fromRGB(220, 40, 50), Color3.fromRGB(60, 110, 230), Color3.fromRGB(255, 205, 50), Color3.fromRGB(240, 240, 250) })[(k + i) % 4 + 1], Enum.Material.Metal).CanCollide = false
		end
	end
	local star = XP("GiantStar", Vector3.new(3, 3, 3), Vector3.new(0, 26.5, 0), Color3.fromRGB(255, 220, 80), Enum.Material.Neon)
	star.CanCollide = false
	local sl = Instance.new("PointLight")
	sl.Range, sl.Brightness, sl.Color, sl.Shadows = 45, 2, Color3.fromRGB(255, 220, 140), false
	sl.Parent = star
	for i = 0, 7 do
		local ang = i / 8 * math.pi * 2
		gift(xmasFolder, a.Center, math.cos(ang) * 17, math.sin(ang) * 17, 3.4, (i * 0.13) % 1)
	end

	-- arvores de Natal com luzes
	for i, t in ipairs({ { 18, 12 }, { -18, 12 }, { 18, -12 }, { -18, -12 }, { 14, 44 }, { -14, 44 }, { 14, -44 }, { -14, -44 } }) do
		xtree(xmasFolder, a.Center, t[1], t[2], 1.4, i <= 4)
	end

	-- presentes espalhados
	local grng = Random.new(99)
	local function blocked(x, z)
		if x > -47 and x < -29 and z > -40 and z < 20 then return true end      -- roda-gigante
		if x > 28 and x < 52 and z > -44 and z < -20 then return true end       -- tenda
		if z > 48 or (math.abs(x) > 14 and math.abs(x) < 29 and z > 16 and z < 44) then return true end -- entrada e barracas
		if x > 38 and x < 50 and z > 0 and z < 12 then return true end
		if x * x + z * z < 22 * 22 then return true end                           -- arvore gigante
		for _, s in ipairs(a.Spawns) do
			local dx, dz = s.X - a.Center.X - x, s.Z - a.Center.Z - z
			if dx * dx + dz * dz < 36 then return true end
		end
		return false
	end
	local placed, tries = 0, 0
	while placed < 22 and tries < 300 do
		tries = tries + 1
		local x, z = grng:NextInteger(-54, 54), grng:NextInteger(-54, 54)
		if not blocked(x, z) then
			placed = placed + 1
			gift(xmasFolder, a.Center, x, z, grng:NextNumber(2.2, 3.4), grng:NextNumber())
		end
	end

	-- bonecos de neve
	for _, s in ipairs({ { -26, -14 }, { 26, -14 }, { -26, 14 }, { 26, 14 } }) do
		local x, z, W = s[1], s[2], Color3.new(1, 1, 1)
		XP("SnowBase", Vector3.new(3.8, 3.8, 3.8), Vector3.new(x, 1.9, z), W)
		XP("SnowMid", Vector3.new(2.8, 2.8, 2.8), Vector3.new(x, 5.2, z), W)
		XP("SnowHead", Vector3.new(2, 2, 2), Vector3.new(x, 7.6, z), W)
		XP("Scarf", Vector3.new(2.4, 0.6, 2.4), Vector3.new(x, 6.5, z), Color3.fromRGB(220, 40, 50))
		XP("Carrot", Vector3.new(0.4, 0.4, 1.2), Vector3.new(x, 7.5, z - 1.5), Color3.fromRGB(255, 140, 30)).CanCollide = false
		XP("HatBrim", Vector3.new(2.5, 0.3, 2.5), Vector3.new(x, 8.7, z), Color3.fromRGB(30, 30, 35))
		XP("Hat", Vector3.new(1.7, 1.4, 1.7), Vector3.new(x, 9.5, z), Color3.fromRGB(30, 30, 35))
		for _, ex in ipairs({ -0.5, 0.5 }) do XP("Eye", Vector3.new(0.3, 0.3, 0.2), Vector3.new(x + ex, 7.9, z - 1.05), Color3.fromRGB(20, 20, 20)).CanCollide = false end
	end

	-- lobby tambem fica nevado
	lobbyXmas = Instance.new("Folder")
	lobbyXmas.Name = "LobbyChristmas"
	lobbyXmas.Parent = workspace
	for _, p in ipairs(map:GetChildren()) do
		if p:IsA("BasePart") and (p.Name == "Lawn" or p.Name == "Path" or p.Name == "Leaves") then recolor(p) end
	end
	for i, t in ipairs({ { 16, 28 }, { -16, 28 }, { 16, 52 }, { -16, 52 } }) do xtree(lobbyXmas, Vector3.new(0, 0, 0), t[1], t[2], 1.5, i <= 2) end

	-- Papai Noel andando pela praca
	local santa, pose, say = makeSanta(xmasFolder)
	local t0 = os.clock()
	santaConn = RunS.Heartbeat:Connect(function()
		local t = os.clock() - t0
		local ang = t * 0.3
		local pos = a.Center + Vector3.new(math.cos(ang) * 17, 0, math.sin(ang) * 17)
		pose(CFrame.lookAt(pos, pos + Vector3.new(-math.sin(ang), 0, math.cos(ang))), t)
		say.Text = (math.floor(t / 5) % 2 == 0) and "HO HO HO!" or "MERRY CHRISTMAS!"
	end)

	if phase ~= "playing" then nextArena = parkArena end
	setScene(currentArena)
	rBanner:FireAllClients("MERRY CHRISTMAS!", Color3.fromRGB(255, 90, 90), 8)
	rSfx:FireAllClients("xmas")
end

local function xmasOff()
	if not xmasActive then return end
	xmasActive = false
	R:SetAttribute("XmasActive", false)
	if santaConn then santaConn:Disconnect() santaConn = nil end
	for p, c in pairs(saved) do
		if p.Parent then p.Color = c end
	end
	table.clear(saved)
	if xmasFolder then xmasFolder:Destroy() xmasFolder = nil end
	if lobbyXmas then lobbyXmas:Destroy() lobbyXmas = nil end
	if parkArena then
		for _, p in ipairs(parkArena.CenterDecor) do p.Parent = parkArena.Folder end
	end
	setScene(currentArena)
end

local XMAS_AT = DateTime.fromUniversalTime(EV.ChristmasYear, EV.ChristmasMonth, EV.ChristmasDay, 0, 0, 0).UnixTimestamp - EV.UtcOffsetHours * 3600
local XMAS_END = XMAS_AT + EV.ChristmasDuration
if EV.TestChristmas then
	XMAS_AT = os.time() + 20
	XMAS_END = XMAS_AT + 180
end
R:SetAttribute("XmasAt", XMAS_AT)
R:SetAttribute("XmasEnd", XMAS_END)
R:SetAttribute("XmasActive", false)
task.spawn(function()
	while true do
		local now = workspace:GetServerTimeNow()
		if now >= XMAS_AT and now < XMAS_END then
			if not xmasActive then xmasOn() end
		elseif xmasActive then
			xmasOff()
		end
		task.wait(1)
	end
end)

-- ===== rodada =====
local function chooseArena()
	if xmasActive and parkArena then
		nextArena = parkArena
		return
	end
	if dinoArena and lastArena ~= dinoArena and math.random() < 0.25 then
		nextArena = dinoArena
		return
	end
	local pick
	repeat pick = arenas[math.random(#arenas)] until pick ~= lastArena or #arenas == 1
	nextArena = pick
end
chooseArena()

local matchActive = false
local botList = {}
local botRequest = nil

local function hasReal()
	for e in pairs(alive) do if not isBot(e) then return true end end
	return false
end

local function refreshSpeeds()
	for e in pairs(alive) do
		local hum = e.Character and e.Character:FindFirstChildOfClass("Humanoid")
		if hum then
			local bot = isBot(e)
			local base = (e == holder) and (bot and CFG.BotHolderSpeed or CFG.HolderSpeed) or (bot and CFG.BotNormalSpeed or CFG.NormalSpeed)
			local b = boost[e]
			if b and os.clock() < b.Until then base = base * b.Mult end
			if beachArena and currentArena == beachArena then
				local hrp = e.Character:FindFirstChild("HumanoidRootPart")
				if hrp and hrp.Position.Z - beachArena.Center.Z < -20 then base = base * 0.75 end -- agua rasa deixa lento
			end
			if hum.WalkSpeed ~= base then hum.WalkSpeed = base end
		end
	end
end

local function trexHit(pos)
	local lp = trexRoot:PointToObjectSpace(pos)
	return math.abs(lp.X) < 4 and lp.Z > -15 and lp.Z < 20 and lp.Y > -3 and lp.Y < 17
end

local function makeBot(i)
	local desc = Instance.new("HumanoidDescription")
	local col = Color3.fromHSV(math.random(), 0.5, 0.95)
	for _, prop in ipairs({ "HeadColor", "TorsoColor", "LeftArmColor", "RightArmColor", "LeftLegColor", "RightLegColor" }) do desc[prop] = col end
	local ok, model = pcall(function() return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15) end)
	if not ok or not model then return nil end
	local hum = model:FindFirstChildOfClass("Humanoid")
	if not hum then model:Destroy() return nil end
	model.Name = "Bot" .. i
	hum.DisplayName = "Bot " .. i
	hum.WalkSpeed = CFG.BotNormalSpeed
	model.Parent = workspace
	local bot = { Character = model, DisplayName = "Bot " .. i, Name = "Bot" .. i, Parent = Players, Skin = CF.Skins[math.random(#CF.Skins)].Id, SetAttribute = function() end }
	botByModel[model] = bot
	return bot
end

local function clampTo(a, v)
	return Vector3.new(a.Center.X + math.clamp(v.X - a.Center.X, -50, 50), v.Y, a.Center.Z + math.clamp(v.Z - a.Center.Z, -50, 50))
end

-- IA simples: quem esta com a bomba persegue o mais proximo, os outros fogem do portador
local function botAI(a)
	while matchActive do
		for _, e in ipairs(botList) do
			if alive[e] and okChar(e) then
				local hum = e.Character:FindFirstChildOfClass("Humanoid")
				local hrp = e.Character.HumanoidRootPart
				local pos = hrp.Position
				if e == holder then
					local best, bd = nil, 1e9
					for o in pairs(alive) do
						if o ~= e and okChar(o) then
							local d = (o.Character.HumanoidRootPart.Position - pos).Magnitude
							if d < bd then best, bd = o, d end
						end
					end
					if best then hum:MoveTo(best.Character.HumanoidRootPart.Position) end
				elseif holder and okChar(holder) then
					local away = pos - holder.Character.HumanoidRootPart.Position
					away = Vector3.new(away.X, 0, away.Z)
					if away.Magnitude < 28 and away.Magnitude > 0.1 then
						hum:MoveTo(clampTo(a, pos + away.Unit * 20))
					elseif math.random() < 0.25 then
						hum:MoveTo(clampTo(a, pos + Vector3.new(math.random(-15, 15), 0, math.random(-15, 15))))
					end
				end
				if e.LastPos and (pos - e.LastPos).Magnitude < 0.5 then
					e.Stuck = (e.Stuck or 0) + 1
					if e.Stuck >= 3 then
						hum.Jump = true
						e.Stuck = 0
					end
				else
					e.Stuck = 0
				end
				e.LastPos = pos
			end
		end
		task.wait(0.3)
	end
end

local function runMatch(a, participants, botMode)
	currentArena = a
	if not botMode then lastArena = a end
	alive = {}
	table.clear(boost)
	matchActive = true
	setScene(a)
	for i, p in ipairs(participants) do
		alive[p] = true
		local pos = a.Spawns[((i - 1) % #a.Spawns) + 1]
		p.Character:PivotTo(CFrame.lookAt(pos, a.Center + Vector3.new(0, 4, 0)))
	end
	phase = "playing"
	msg("Arena: " .. a.Name, Color3.fromRGB(140, 220, 255))
	if a == dinoArena then
		task.delay(1.5, function() msg("EVENTO DINO WORLD! Cuidado com o T-Rex! Moedas em dobro!", Color3.fromRGB(255, 190, 60)) end)
	end
	if a == beachArena then
		task.delay(1.5, function() msg("Praia de Copacabana: a agua NAO mata, mas te deixa mais lento!", Color3.fromRGB(120, 210, 255)) end)
	end
	for t = 3, 1, -1 do
		status = "Preparar... " .. t
		push()
		task.wait(1)
	end
	dinoActive = (a == dinoArena)
	if dinoActive and trexReset then trexReset() end
	if botMode then task.spawn(botAI, a) end
	local cycle = 0
	while count() > 1 and (not botMode or hasReal()) do
		cycle = cycle + 1
		local list = aliveList()
		if #list < 2 then break end
		bombTotal = math.max(8, math.random(CFG.BombMin, CFG.BombMax) - (cycle - 1) * 2)
		bombEnd = os.clock() + bombTotal
		status = "Fuja da bomba!"
		giveBomb(list[math.random(#list)])
		msg("A bomba esta com " .. holder.DisplayName .. "!", Color3.fromRGB(255, 200, 80))
		while os.clock() < bombEnd and count() > 1 and (not botMode or hasReal()) do
			task.wait(0.1)
			refreshSpeeds()
			for p in pairs(alive) do
				local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
				if not okChar(p) or p.Parent ~= Players then
					alive[p] = nil
				elseif hrp and hrp.Position.Y < -12 then
					eliminate(p, " caiu!")
				elseif dinoActive and hrp and trexHit(hrp.Position) then
					eliminate(p, " foi pisoteado pelo T-Rex!")
				end
			end
			if count() > 1 and (not holder or not alive[holder]) then
				local l = aliveList()
				if #l > 0 then giveBomb(l[math.random(#l)]) end
			end
		end
		if count() <= 1 or (botMode and not hasReal()) then break end
		explode(holder)
		task.wait(2.5)
	end
	clearBomb()
	matchActive = false
	dinoActive = false
	phase = "ended"
	local w = aliveList()[1]
	if botMode and not hasReal() then w = nil end
	local winC = botMode and CFG.BotWinCoins or CFG.WinCoins
	local playC = botMode and CFG.BotPlayCoins or CFG.PlayCoins
	if a == dinoArena then winC, playC = winC * 2, playC * 2 end
	for _, p in ipairs(participants) do stat(p, "Coins", playC) end
	if w then
		if not botMode then stat(w, "Wins", 1) end
		stat(w, "Coins", winC)
		status = w.DisplayName .. " venceu!"
		msg(w.DisplayName .. " VENCEU!" .. (isBot(w) and "" or (" +" .. winC .. " moedas")), Color3.fromRGB(120, 255, 140))
	elseif botMode then
		status = "Os bots venceram!"
	else
		status = "Ninguem sobreviveu!"
	end
	alive = {}
	currentArena = nil
	if not botMode then chooseArena() end
	push()
	task.wait(5)
	setScene(nil)
	for _, p in ipairs(participants) do
		if isBot(p) then
			botByModel[p.Character] = nil
			p.Character:Destroy()
		elseif p.Parent == Players then
			p:LoadCharacter()
		end
	end
	task.wait(2)
end

local function playRound()
	local participants = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if okChar(p) then participants[#participants + 1] = p end
	end
	if #participants < CFG.MinPlayers then return end
	runMatch(nextArena, participants, false)
end

local function playBotRound(p, n)
	local ents = { p }
	botList = {}
	for i = 1, n do
		local b = makeBot(i)
		if b then
			ents[#ents + 1] = b
			botList[#botList + 1] = b
		end
	end
	if #botList == 0 then
		rMsg:FireClient(p, "Nao foi possivel criar os bots", Color3.fromRGB(255, 120, 100))
		return
	end
	runMatch(botArena, ents, true)
	botList = {}
end

rBotAct.OnServerEvent:Connect(function(p, action, n)
	if action == "cancel" then
		if botRequest and botRequest.Player == p then
			botRequest = nil
			rMsg:FireClient(p, "Fila de bots cancelada", Color3.fromRGB(255, 220, 120))
		end
		return
	end
	if action ~= "start" or (n ~= 3 and n ~= 5 and n ~= 7) then return end
	if not okChar(p) or alive[p] then return end
	botRequest = { Player = p, N = n }
	if phase == "playing" or phase == "ended" then
		rMsg:FireClient(p, "Na fila: a partida com bots comeca quando a rodada atual acabar", Color3.fromRGB(255, 220, 120))
	else
		rMsg:FireClient(p, "Preparando partida com " .. n .. " bots...", Color3.fromRGB(140, 220, 255))
	end
end)

task.spawn(function()
	while true do
		if botRequest then
			local req = botRequest
			botRequest = nil
			if req.Player.Parent == Players and okChar(req.Player) then playBotRound(req.Player, req.N) end
		else
			phase = "waiting"
			while #Players:GetPlayers() < CFG.MinPlayers and not botRequest do
				status = "Esperando jogadores (" .. #Players:GetPlayers() .. "/" .. CFG.MinPlayers .. ")"
				push()
				task.wait(1)
			end
			local aborted = botRequest ~= nil
			if not aborted then
				for t = CFG.Intermission, 1, -1 do
					if #Players:GetPlayers() < CFG.MinPlayers or botRequest then aborted = true break end
					phase, status = "intermission", "Rodada comeca em " .. t .. "s"
					push()
					task.wait(1)
				end
			end
			if not aborted then playRound() end
		end
		task.wait()
	end
end)
]]></ProtectedString></Properties><Item class="LocalScript" referent="RBX3"><Properties><string name="Name">PBClient</string><ProtectedString name="Source"><![CDATA[-- PBClient (LocalScript) | vai para StarterPlayerScripts automaticamente
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local RunS = game:GetService("RunService")
local TS = game:GetService("TweenService")
local PPS = game:GetService("ProximityPromptService")
local CS = game:GetService("CollectionService")

local lp = Players.LocalPlayer
local R = RS:WaitForChild("PB")
local CF = require(RS:WaitForChild("PBConfig"))
local rState, rMsg, rSkinState, rSkinAct, rOpenUI, rBotAct = R:WaitForChild("State"), R:WaitForChild("Msg"), R:WaitForChild("SkinState"), R:WaitForChild("SkinAct"), R:WaitForChild("OpenUI"), R:WaitForChild("BotAct")

local gui = Instance.new("ScreenGui")
gui.Name, gui.ResetOnSpawn, gui.IgnoreGuiInset = "PBUI", false, true
gui.Parent = lp:WaitForChild("PlayerGui")

-- paleta estilo Grow a Garden
local CREAM, BROWN, GREEN, DKGREEN, ORANGE, YELLOW = Color3.fromRGB(255, 246, 220), Color3.fromRGB(80, 52, 28), Color3.fromRGB(110, 200, 80), Color3.fromRGB(70, 150, 55), Color3.fromRGB(255, 150, 40), Color3.fromRGB(255, 205, 50)
local FONT = Enum.Font.FredokaOne
local function mk(cls, props, parent)
	local o = Instance.new(cls)
	for k, v in pairs(props) do o[k] = v end
	o.Parent = parent
	return o
end
local function round(o, r) mk("UICorner", { CornerRadius = UDim.new(0, r or 10) }, o) end
local function label(parent, text, size, pos, color, align)
	return mk("TextLabel", { Text = text, Size = size, Position = pos, BackgroundTransparency = 1, TextColor3 = color or BROWN, Font = FONT, TextScaled = true, TextXAlignment = align or Enum.TextXAlignment.Left }, parent)
end
local function button(parent, text, size, pos, color)
	local b = mk("TextButton", { Text = text, Size = size, Position = pos, BackgroundColor3 = color or GREEN, TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0.5, Font = FONT, TextScaled = true }, parent)
	round(b, 8)
	mk("UIStroke", { Color = Color3.fromRGB(40, 90, 30), Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, b)
	return b
end

-- textura de studs (bolinhas em grade) para icones e botoes
local function studTex(parent, w, h, step, dot, transp)
	for x = step / 2, w - 1, step do
		for y = step / 2, h - 1, step do
			local d = mk("Frame", { Size = UDim2.new(0, dot, 0, dot), Position = UDim2.new(0, x - dot / 2, 0, y - dot / 2), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = transp or 0.55, BorderSizePixel = 0 }, parent)
			round(d, dot)
		end
	end
end
-- icone "tijolo" com studs: quadrado pequeno + 2 studs em cima
local function brick(parent, pos, size, color, symbol)
	local f = mk("Frame", { Size = UDim2.new(0, size, 0, size), Position = pos, BackgroundColor3 = color }, parent)
	round(f, 5)
	mk("UIStroke", { Color = Color3.fromRGB(60, 40, 20), Thickness = 1.5 }, f)
	studTex(f, size, size, size / 3, 3, 0.6)
	if symbol then
		mk("TextLabel", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = symbol, TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0.3, Font = FONT, TextScaled = true }, f)
	end
	return f
end

-- ===== HUD pequeno de dinheiro e vitorias =====
local function pill(y, symbol, symColor)
	local f = mk("Frame", { Size = UDim2.new(0, 132, 0, 32), Position = UDim2.new(0, 10, 0, y), BackgroundColor3 = CREAM }, gui)
	round(f, 16)
	mk("UIStroke", { Color = DKGREEN, Thickness = 2 }, f)
	brick(f, UDim2.new(0, 4, 0, 4), 24, symColor, symbol)
	local n = mk("TextLabel", { Size = UDim2.new(1, -40, 1, -8), Position = UDim2.new(0, 34, 0, 4), BackgroundTransparency = 1, TextColor3 = BROWN, Font = FONT, TextScaled = true, Text = "0", TextXAlignment = Enum.TextXAlignment.Left }, f)
	local sc = mk("UIScale", { Scale = 1 }, f)
	return n, sc
end
local coinN, coinSc = pill(10, "$", YELLOW)
local winN, winSc = pill(46, "W", ORANGE)
local function bump(sc)
	sc.Scale = 1.12
	TS:Create(sc, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
end
local function coinsNow()
	local ls = lp:FindFirstChild("leaderstats")
	local c = ls and ls:FindFirstChild("Coins")
	return c and c.Value or 0
end
local renderSkins, renderCoins, skinsF, coinsF, botsF, chefF, renderChef
task.spawn(function()
	local ls = lp:WaitForChild("leaderstats")
	local c, w = ls:WaitForChild("Coins"), ls:WaitForChild("Wins")
	coinN.Text, winN.Text = tostring(c.Value), tostring(w.Value)
	c.Changed:Connect(function()
		coinN.Text = tostring(c.Value)
		bump(coinSc)
		if skinsF and skinsF.Visible then renderSkins() end
	end)
	w.Changed:Connect(function()
		winN.Text = tostring(w.Value)
		bump(winSc)
	end)
end)

-- ===== alerta, painel superior, mensagens =====
local danger = mk("Frame", { Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.fromRGB(255, 30, 20), BackgroundTransparency = 1, Visible = false }, gui)
local dangerText = mk("TextLabel", { Size = UDim2.new(0, 560, 0, 70), Position = UDim2.new(0.5, -280, 0.64, 0), BackgroundTransparency = 1, Text = "VOCE ESTA COM A BOMBA!\nTOQUE EM ALGUEM!", TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0, Font = FONT, TextScaled = true, Visible = false }, gui)

local top = mk("Frame", { Size = UDim2.new(0, 420, 0, 84), Position = UDim2.new(0.5, -210, 0, 10), BackgroundColor3 = CREAM }, gui)
round(top, 14)
mk("UIStroke", { Color = DKGREEN, Thickness = 3 }, top)
local statusLbl = mk("TextLabel", { Size = UDim2.new(1, -20, 0, 40), Position = UDim2.new(0, 10, 0, 5), BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(230, 110, 20), Font = FONT, TextScaled = true, Text = "..." }, top)
local subLbl = mk("TextLabel", { Size = UDim2.new(1, -20, 0, 22), Position = UDim2.new(0, 10, 0, 46), BackgroundTransparency = 1, TextColor3 = BROWN, Font = FONT, TextScaled = true, Text = "" }, top)
local arenaLbl = mk("TextLabel", { Size = UDim2.new(1, -20, 0, 16), Position = UDim2.new(0, 10, 0, 67), BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(40, 120, 190), Font = FONT, TextScaled = true, Text = "" }, top)

local msgLbl = mk("TextLabel", { Size = UDim2.new(0, 640, 0, 48), Position = UDim2.new(0.5, -320, 0.22, 0), BackgroundTransparency = 1, TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 1, TextTransparency = 1, Font = FONT, TextScaled = true, Text = "" }, gui)
local msgId = 0
rMsg.OnClientEvent:Connect(function(text, color)
	msgId = msgId + 1
	local id = msgId
	msgLbl.Text, msgLbl.TextColor3, msgLbl.TextTransparency, msgLbl.TextStrokeTransparency = text, color or Color3.new(1, 1, 1), 0, 0
	task.delay(2.5, function()
		if id == msgId then TS:Create(msgLbl, TweenInfo.new(0.6), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play() end
	end)
end)

local bombEndT = 0
rState.OnClientEvent:Connect(function(s)
	bombEndT = s.BombEnd or 0
	statusLbl.Text = s.Text
	if s.Phase == "playing" then
		subLbl.Text = "Vivos: " .. s.Alive .. (s.Holder ~= "" and ("   |   Bomba: " .. s.Holder) or "")
		arenaLbl.Text = "Arena: " .. s.Arena
	else
		subLbl.Text = (s.Phase == "ended") and "" or "Passe a bomba tocando nos outros!"
		arenaLbl.Text = s.Arena ~= "" and ("Proxima arena: " .. s.Arena) or ""
	end
end)

local function refreshDanger()
	local has = lp:GetAttribute("HasBomb") == true
	danger.Visible, dangerText.Visible = has, has
end
lp:GetAttributeChangedSignal("HasBomb"):Connect(refreshDanger)
refreshDanger()
RunS.RenderStepped:Connect(function()
	if danger.Visible then
		danger.BackgroundTransparency = 0.82 - 0.12 * math.abs(math.sin(os.clock() * 6))
		dangerText.Rotation = math.sin(os.clock() * 12) * 2
	end
end)

-- ===== prompt pequeno (substitui o botao gigante padrao) =====
PPS.PromptShown:Connect(function(prompt)
	if prompt.Style == Enum.ProximityPromptStyle.Default then return end
	local bb = mk("BillboardGui", { Size = UDim2.new(0, 150, 0, 30), StudsOffset = Vector3.new(0, 4, 0), AlwaysOnTop = true, Adornee = prompt.Parent }, lp.PlayerGui)
	local b = mk("TextButton", { Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = CREAM, Text = "", AutoButtonColor = false }, bb)
	round(b, 15)
	mk("UIStroke", { Color = DKGREEN, Thickness = 2 }, b)
	local key = brick(b, UDim2.new(0, 3, 0, 3), 24, GREEN, prompt.KeyboardKeyCode == Enum.KeyCode.E and "E" or "!")
	mk("TextLabel", { Size = UDim2.new(1, -36, 1, -8), Position = UDim2.new(0, 32, 0, 4), BackgroundTransparency = 1, Text = prompt.ActionText, TextColor3 = BROWN, Font = FONT, TextScaled = true, TextXAlignment = Enum.TextXAlignment.Left }, b)
	b.Activated:Connect(function()
		prompt:InputHoldBegin()
		task.wait()
		prompt:InputHoldEnd()
	end)
	prompt.PromptHidden:Connect(function() bb:Destroy() end)
end)

-- ===== paineis (estilo jardim) =====
local function panel(title, strokeColor)
	local f = mk("Frame", { Size = UDim2.new(0, 520, 0, 420), Position = UDim2.new(0.5, -260, 0.5, -210), BackgroundColor3 = CREAM, Visible = false }, gui)
	round(f, 16)
	mk("UIStroke", { Color = strokeColor, Thickness = 4 }, f)
	local head = mk("Frame", { Size = UDim2.new(1, 0, 0, 46), BackgroundColor3 = strokeColor }, f)
	round(head, 16)
	label(head, title, UDim2.new(0, 360, 0, 34), UDim2.new(0, 16, 0, 6), Color3.new(1, 1, 1))
	local x = button(f, "X", UDim2.new(0, 32, 0, 32), UDim2.new(1, -40, 0, 7), Color3.fromRGB(225, 80, 70))
	x.MouseButton1Click:Connect(function() f.Visible = false end)
	local list = mk("ScrollingFrame", { Size = UDim2.new(1, -24, 1, -60), Position = UDim2.new(0, 12, 0, 54), BackgroundTransparency = 1, ScrollBarThickness = 6, CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y }, f)
	mk("UIListLayout", { Padding = UDim.new(0, 8) }, list)
	return f, list
end

-- skins
local owned, equipped, burgers = { classic = true }, "classic", 0
local skinsList
skinsF, skinsList = panel("Skins de Bomba", Color3.fromRGB(160, 100, 215))
renderSkins = function()
	for _, c in ipairs(skinsList:GetChildren()) do if c:IsA("Frame") then c:Destroy() end end
	for _, s in ipairs(CF.Skins) do
		local row = mk("Frame", { Size = UDim2.new(1, -8, 0, 58), BackgroundColor3 = Color3.fromRGB(255, 232, 180) }, skinsList)
		round(row, 10)
		local sw = brick(row, UDim2.new(0, 10, 0, 9), 40, s.Base)
		mk("UIStroke", { Color = s.Flash, Thickness = 3 }, sw)
		label(row, s.Name, UDim2.new(0, 190, 0, 24), UDim2.new(0, 60, 0, 7))
		local sub = owned[s.Id] and "Voce tem" or (s.Free and "Gratis com a capivara no lobby!" or "Bloqueada")
		label(row, sub, UDim2.new(0, 220, 0, 16), UDim2.new(0, 60, 0, 34), Color3.fromRGB(140, 100, 60))
		if owned[s.Id] then
			local on = equipped == s.Id
			local b = button(row, on and "Equipada" or "Equipar", UDim2.new(0, 110, 0, 32), UDim2.new(1, -120, 0, 13), on and Color3.fromRGB(150, 140, 125) or GREEN)
			b.MouseButton1Click:Connect(function() if not on then rSkinAct:FireServer("equip", s.Id) end end)
		else
			if s.Coins then
				local can = coinsNow() >= s.Coins
				local b = button(row, "$ " .. s.Coins, UDim2.new(0, 100, 0, s.Robux and 24 or 32), UDim2.new(1, -110, 0, s.Robux and 5 or 13), can and ORANGE or Color3.fromRGB(150, 140, 125))
				b.MouseButton1Click:Connect(function() rSkinAct:FireServer("coins", s.Id) end)
			end
			if s.Robux then
				local b = button(row, "R$ " .. s.Robux, UDim2.new(0, 100, 0, s.Coins and 24 or 32), UDim2.new(1, -110, 0, s.Coins and 30 or 13), Color3.fromRGB(60, 190, 110))
				b.MouseButton1Click:Connect(function() rSkinAct:FireServer("robux", s.Id) end)
			end
		end
	end
end
rSkinState.OnClientEvent:Connect(function(s)
	owned, equipped, burgers = s.Owned, s.Equipped, s.Burgers or 0
	if skinsF.Visible then renderSkins() end
	if chefF and chefF.Visible then renderChef() end
end)

