-- ===== mapa: TODAS as pecas com studs em todas as faces =====
local FACES = { "TopSurface", "BottomSurface", "LeftSurface", "RightSurface", "FrontSurface", "BackSurface" }
local PLASTIC = Enum.Material.Plastic
local map = Instance.new("Folder")
map.Name = "PBMap"
map.Parent = workspace

local function P(parent, name, size, cf, color, mat, transp)
	local p = Instance.new("Part")
	p.Name, p.Size, p.CFrame, p.Color = name, size, cf, color
	p.Material = mat or PLASTIC
	p.Anchored = true
	p.Transparency = transp or 0
	p.CastShadow = math.max(size.X, size.Y, size.Z) >= 5 -- sombra so em pecas grandes (celular)
	for _, f in ipairs(FACES) do p[f] = Enum.SurfaceType.Studs end
	p.Parent = parent
	return p
end
local function sign(part, text, offset, w, h)
	local b = Instance.new("BillboardGui")
	b.Size, b.StudsOffset = UDim2.new(0, w or 400, 0, h or 100), Vector3.new(0, offset, 0)
	b.Parent = part
	local t = Instance.new("TextLabel")
	t.Size, t.BackgroundTransparency, t.Text, t.TextScaled = UDim2.new(1, 0, 1, 0), 1, text, true
	t.Font, t.TextColor3, t.TextStrokeTransparency = Enum.Font.FredokaOne, Color3.new(1, 1, 1), 0
	t.Parent = b
end

local oldBase = workspace:FindFirstChild("Baseplate")
if oldBase then oldBase:Destroy() end
local oldSpawn = workspace:FindFirstChildOfClass("SpawnLocation")
if oldSpawn then oldSpawn:Destroy() end

-- ===== lobby estilo Grow a Garden =====
local WOOD, WOOD2, PATH = Color3.fromRGB(196, 150, 90), Color3.fromRGB(140, 95, 55), Color3.fromRGB(214, 180, 120)

local function makeCapy(scale)
	local m = Instance.new("Model")
	m.Name = "Capybara"
	local function part(nm, sz, off, col)
		local p = Instance.new("Part")
		p.Name, p.Size, p.Color, p.Material = nm, sz * scale, col, PLASTIC
		p.Anchored, p.CanCollide = true, false
		p.CFrame = CFrame.new(off * scale)
		for _, f in ipairs(FACES) do p[f] = Enum.SurfaceType.Studs end
		p.Parent = m
		return p
	end
	local brown, dark = Color3.fromRGB(156, 110, 72), Color3.fromRGB(115, 78, 48)
	m.PrimaryPart = part("Body", Vector3.new(3, 2.2, 4.4), Vector3.new(0, 0, 0), brown)
	part("Head", Vector3.new(2.2, 2, 2.2), Vector3.new(0, 0.5, -3), Color3.fromRGB(170, 125, 85))
	part("Snout", Vector3.new(1.6, 1.2, 1.2), Vector3.new(0, 0.1, -4.3), dark)
	part("Nose", Vector3.new(0.7, 0.5, 0.4), Vector3.new(0, 0.5, -4.95), Color3.fromRGB(25, 20, 20))
	for _, sx in ipairs({ -1, 1 }) do
		part("Eye", Vector3.new(0.35, 0.35, 0.2), Vector3.new(0.75 * sx, 0.9, -4.12), Color3.fromRGB(20, 20, 20))
		part("Ear", Vector3.new(0.6, 0.6, 0.4), Vector3.new(0.85 * sx, 1.7, -2.6), dark)
		for _, sz in ipairs({ -1.5, 1.5 }) do
			part("Leg", Vector3.new(0.9, 1.1, 0.9), Vector3.new(1.0 * sx, -1.65, sz), dark)
		end
	end
	part("Orange", Vector3.new(1, 0.8, 1), Vector3.new(0, 1.8, -3.1), Color3.fromRGB(255, 150, 40))
	part("Leaf", Vector3.new(0.4, 0.3, 0.4), Vector3.new(0, 2.35, -3.1), Color3.fromRGB(60, 160, 70))
	return m
end

