local skinBtn = sideBtn("Skins", 90, Color3.fromRGB(160, 100, 215))
local coinBtn = sideBtn("Moedas", 124, ORANGE)
local botBtn = sideBtn("Bots", 158, GREEN)
local frames = { skins = skinsF, coins = coinsF, bots = botsF, chef = chefF }
local function open(which)
	for name, f in pairs(frames) do
		f.Visible = (name == which) and not f.Visible
	end
	if skinsF.Visible then renderSkins() end
	if coinsF.Visible then renderCoins() end
	if chefF.Visible then renderChef() end
end
skinBtn.MouseButton1Click:Connect(function() open("skins") end)
coinBtn.MouseButton1Click:Connect(function() open("coins") end)
botBtn.MouseButton1Click:Connect(function() open("bots") end)
rOpenUI.OnClientEvent:Connect(function(which)
	for _, f in pairs(frames) do f.Visible = false end
	open(which)
end)

-- ===== mini contador da bomba =====
local timerPill = mk("Frame", { Size = UDim2.new(0, 150, 0, 28), Position = UDim2.new(0.5, -75, 0, 98), BackgroundColor3 = CREAM, Visible = false }, gui)
round(timerPill, 14)
mk("UIStroke", { Color = Color3.fromRGB(220, 70, 50), Thickness = 2 }, timerPill)
brick(timerPill, UDim2.new(0, 3, 0, 3), 22, Color3.fromRGB(40, 40, 50), "!")
local timerLbl = mk("TextLabel", { Size = UDim2.new(1, -34, 1, -6), Position = UDim2.new(0, 30, 0, 3), BackgroundTransparency = 1, TextColor3 = BROWN, Font = FONT, TextScaled = true, Text = "", TextXAlignment = Enum.TextXAlignment.Left }, timerPill)
RunS.RenderStepped:Connect(function()
	local now = workspace:GetServerTimeNow()
	for _, b in ipairs(CS:GetTagged("PBBomb")) do
		local bb = b:FindFirstChildOfClass("BillboardGui")
		local t = bb and bb:FindFirstChild("T")
		local endT = b:GetAttribute("EndT")
		if t and endT then
			local left = math.max(0, endT - now)
			t.Text = string.format("%.1f", left)
			t.TextColor3 = (left < 3) and Color3.fromRGB(255, 90, 80) or Color3.new(1, 1, 1)
		end
	end
	local left = bombEndT - now
	if bombEndT > 0 and left > 0 then
		timerPill.Visible = true
		timerLbl.Text = "Explode em " .. string.format("%.1f", left) .. "s"
		timerLbl.TextColor3 = (left < 3) and Color3.fromRGB(230, 60, 40) or BROWN
	else
		timerPill.Visible = false
	end
end)

-- ===== EVENTOS: Taco Event, contagem de Natal, neve, musica =====
local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")
local EV = CF.Events
local rBanner, rSfx, rTaco = R:WaitForChild("Banner"), R:WaitForChild("Sfx"), R:WaitForChild("Taco")

-- banner grande no centro
local bannerLbl = mk("TextLabel", { Size = UDim2.new(0, 820, 0, 100), Position = UDim2.new(0.5, -410, 0.28, 0), BackgroundTransparency = 1, TextColor3 = Color3.new(1, 1, 1), TextStrokeColor3 = Color3.fromRGB(40, 20, 20), TextStrokeTransparency = 1, TextTransparency = 1, Font = FONT, TextScaled = true, Text = "" }, gui)
local bannerScale = mk("UIScale", { Scale = 1 }, bannerLbl)
local bannerId = 0
local function showBanner(text, color, secs)
	bannerId = bannerId + 1
	local id = bannerId
	bannerLbl.Text, bannerLbl.TextColor3 = text, color or Color3.new(1, 1, 1)
	bannerLbl.TextTransparency, bannerLbl.TextStrokeTransparency = 0, 0
	bannerScale.Scale = 0.6
	TS:Create(bannerScale, TweenInfo.new(0.45, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	task.delay(secs or 5, function()
		if id == bannerId then TS:Create(bannerLbl, TweenInfo.new(0.7), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play() end
	end)
end
rBanner.OnClientEvent:Connect(showBanner)

-- sons: o "instrumento" e o ping padrao do Roblox em varias alturas (EV.MusicId aceita musica propria)
local function note(semi, vol)
	local s = Instance.new("Sound")
	s.SoundId, s.Volume, s.PlaybackSpeed = EV.NoteSound, vol or 0.35, 2 ^ ((semi + EV.NoteBase) / 12)
	s.Parent = SoundService
	s:Play()
	Debris:AddItem(s, 3)
end
local function melody(seq, beat)
	for _, n in ipairs(seq) do
		if n[1] then note(n[1]) end
		task.wait(n[2] * beat)
	end
end
local JINGLE = { { 4, 1 }, { 4, 1 }, { 4, 2 }, { 4, 1 }, { 4, 1 }, { 4, 2 }, { 4, 1 }, { 7, 1 }, { 0, 1.5 }, { 2, 0.5 }, { 4, 4 },
	{ 5, 1 }, { 5, 1 }, { 5, 1.5 }, { 5, 0.5 }, { 5, 1 }, { 4, 1 }, { 4, 1 }, { 4, 0.5 }, { 4, 0.5 }, { 4, 1 }, { 2, 1 }, { 2, 1 }, { 4, 1 }, { 2, 2 }, { 7, 2 } }
rSfx.OnClientEvent:Connect(function(kind)
	if kind == "pick" then
		note(12, 0.4)
		task.delay(0.08, note, 16, 0.4)
	elseif kind == "taco" then
		task.spawn(melody, { { 0, 0.5 }, { 4, 0.5 }, { 7, 0.5 }, { 12, 1.5 } }, 0.12)
	elseif kind == "xmas" then
		task.spawn(melody, JINGLE, 0.22)
	end
end)

-- neve local (so aparece no evento de Natal)
local snowPart, snowEm
local function setSnow(on)
	if on and not snowPart then
		snowPart = Instance.new("Part")
		snowPart.Anchored, snowPart.CanCollide, snowPart.CanQuery, snowPart.CanTouch, snowPart.Transparency = true, false, false, false, 1
		snowPart.Size = Vector3.new(90, 1, 90)
		snowPart.Parent = workspace
		snowEm = Instance.new("ParticleEmitter")
		snowEm.Rate, snowEm.Lifetime, snowEm.Speed = 70, NumberRange.new(5, 7), NumberRange.new(6, 10)
		snowEm.EmissionDirection, snowEm.SpreadAngle = Enum.NormalId.Bottom, Vector2.new(12, 12)
		snowEm.Size, snowEm.Transparency, snowEm.LightEmission = NumberSequence.new(0.4), NumberSequence.new(0.1), 0.5
		snowEm.RotSpeed, snowEm.Rotation = NumberRange.new(-60, 60), NumberRange.new(0, 360)
		snowEm.Parent = snowPart
	end
	if snowEm then snowEm.Enabled = on end
end

-- musica de Natal em loop enquanto o evento estiver ativo
local xmasMusic
local musicToken = 0
local function setXmas(on)
	setSnow(on)
	musicToken = musicToken + 1
	local my = musicToken
	if xmasMusic then xmasMusic:Destroy() xmasMusic = nil end
	if not on then return end
	if EV.MusicId ~= "" then
		xmasMusic = Instance.new("Sound")
		xmasMusic.SoundId, xmasMusic.Volume, xmasMusic.Looped, xmasMusic.Parent = EV.MusicId, 0.5, true, SoundService
		xmasMusic:Play()
	else
		task.spawn(function()
			while musicToken == my do
				melody(JINGLE, 0.24)
				task.wait(8)
			end
		end)
	end
end
R:GetAttributeChangedSignal("XmasActive"):Connect(function() setXmas(R:GetAttribute("XmasActive") == true) end)
if R:GetAttribute("XmasActive") == true then
	setXmas(true)
	showBanner("MERRY CHRISTMAS!", Color3.fromRGB(255, 90, 90), 6)
end

-- paineis de contagem (sincronizados pelo relogio do servidor)
local function countPill(y, color, symbol)
	local f = mk("Frame", { Size = UDim2.new(0, 330, 0, 30), Position = UDim2.new(0.5, -165, 0, y), BackgroundColor3 = CREAM, Visible = false }, gui)
	round(f, 15)
	mk("UIStroke", { Color = color, Thickness = 2 }, f)
	brick(f, UDim2.new(0, 3, 0, 3), 24, color, symbol)
	local l = mk("TextLabel", { Size = UDim2.new(1, -38, 1, -6), Position = UDim2.new(0, 34, 0, 3), BackgroundTransparency = 1, TextColor3 = BROWN, Font = FONT, TextScaled = true, Text = "", TextXAlignment = Enum.TextXAlignment.Left }, f)
	return f, l
end
local xmasPill, xmasLbl = countPill(130, Color3.fromRGB(205, 40, 50), "*")
local tacoPill, tacoLbl = countPill(164, Color3.fromRGB(240, 140, 40), "T")
local function hms(s)
	s = math.max(0, math.floor(s))
	return math.floor(s / 86400), math.floor(s % 86400 / 3600), math.floor(s % 3600 / 60), s % 60
end

-- tacos caindo (desenhados aqui, posicao decidida pelo servidor)
local tacoFolder = Instance.new("Folder")
tacoFolder.Name = "PBTacos"
tacoFolder.Parent = workspace
local tacos = {}
local function burst(pos, colors, n)
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.Transparency, p.Size, p.Position = true, false, false, false, 1, Vector3.new(0.5, 0.5, 0.5), pos
	p.Parent = tacoFolder
	local e = Instance.new("ParticleEmitter")
	e.Color, e.Lifetime, e.Speed = ColorSequence.new(colors), NumberRange.new(0.5, 0.9), NumberRange.new(10, 18)
	e.SpreadAngle, e.Size, e.Rate, e.LightEmission = Vector2.new(180, 180), NumberSequence.new(0.7, 0), 0, 0.4
	e.Acceleration = Vector3.new(0, -30, 0)
	e.Parent = p
	e:Emit(n)
	Debris:AddItem(p, 1.5)
end
local function buildTaco()
	local m = Instance.new("Model")
	local function part(sz, off, col)
		local p = Instance.new("Part")
		p.Size, p.Color, p.Material, p.Anchored = sz, col, Enum.Material.Plastic, true
		p.CanCollide, p.CanTouch, p.CanQuery, p.CastShadow = false, false, false, false
		p.CFrame = CFrame.new(off)
		for _, f in ipairs({ "TopSurface", "BottomSurface", "LeftSurface", "RightSurface", "FrontSurface", "BackSurface" }) do p[f] = Enum.SurfaceType.Studs end
		p.Parent = m
		return p
	end
	m.PrimaryPart = part(Vector3.new(2.6, 1.2, 1.6), Vector3.new(0, 0, 0), Color3.fromRGB(245, 200, 70))
	part(Vector3.new(2.4, 0.35, 1.5), Vector3.new(0, 0.75, 0), Color3.fromRGB(80, 190, 70))
	part(Vector3.new(1.6, 0.35, 1.0), Vector3.new(0, 1.1, 0), Color3.fromRGB(120, 70, 40))
	part(Vector3.new(0.6, 0.4, 0.6), Vector3.new(0.6, 1.4, 0), Color3.fromRGB(225, 50, 40))
	m.Parent = tacoFolder
	return m
end
local function removeTaco(id, pop)
	local tk = tacos[id]
	if not tk then return end
	tacos[id] = nil
	if pop then
		burst(Vector3.new(tk.x, 3, tk.z), ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 220, 80)), ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 90, 60)) }), 14)
	end
	tk.model:Destroy()
end
rTaco.OnClientEvent:Connect(function(kind, id, x, z, fall, born)
	if kind == "spawn" then
		tacos[id] = { model = buildTaco(), x = x, z = z, fall = fall, born = born, yaw = (id * 2.4) % 6.28, landed = false }
	elseif kind == "take" then
		removeTaco(id, true)
	end
end)

local lastBulb = 0
RunS.RenderStepped:Connect(function()
	local now = workspace:GetServerTimeNow()

	-- tacos
	for id, tk in pairs(tacos) do
		local t = now - tk.born
		if t > tk.fall + 9 then
			removeTaco(id, false)
		else
			local y, landed = 1.4, t >= tk.fall
			if not landed then
				local p = math.max(0, t) / tk.fall
				y = 80 - 78.6 * p * p
			end
			local spin = landed and (tk.fall * 6) or (math.max(0, t) * 6)
			tk.model:PivotTo(CFrame.new(tk.x, y, tk.z) * CFrame.Angles(0, tk.yaw + spin, 0) * CFrame.Angles(landed and 0 or 0.5, 0, 0))
			if landed and not tk.landed then
				tk.landed = true
				burst(Vector3.new(tk.x, 2, tk.z), ColorSequence.new(Color3.fromRGB(255, 200, 80)), 6)
			end
		end
	end

	-- neve acompanha a camera
	if snowPart and workspace.CurrentCamera then
		local c = workspace.CurrentCamera.CFrame.Position
		snowPart.CFrame = CFrame.new(c.X, c.Y + 32, c.Z)
	end

	-- luzes decorativas (roda-gigante, arvores): troca de cor a cada 0.4s, tudo local
	if now - lastBulb > 0.4 then
		lastBulb = now
		local step = math.floor(now * 2.5)
		for i, b in ipairs(CS:GetTagged("PBBulb")) do
			b.Color = Color3.fromHSV((i * 0.13 + step * 0.21) % 1, 0.85, 1)
		end
	end

	-- contagem de Natal
	local xAt, xEnd = R:GetAttribute("XmasAt"), R:GetAttribute("XmasEnd")
	if xAt and xEnd then
		if R:GetAttribute("XmasActive") == true then
			local _, h, m, s = hms(xEnd - now)
			xmasPill.Visible = true
			xmasLbl.Text = string.format("MERRY CHRISTMAS!  ends in %02d:%02d:%02d", h, m, s)
		elseif now < xAt then
			local d, h, m, s = hms(xAt - now)
			xmasPill.Visible = true
			xmasLbl.Text = string.format("CHRISTMAS IN  %dd %02dh %02dm %02ds", d, h, m, s)
		else
			xmasPill.Visible = false
		end
	end

	-- contagem do Taco Event
	local tAt = R:GetAttribute("TacoAt")
	if R:GetAttribute("TacoLive") == true then
		tacoPill.Visible = true
		tacoLbl.Text = string.format("TACO EVENT LIVE!  %ds left", math.max(0, math.ceil((R:GetAttribute("TacoEnd") or now) - now)))
	elseif tAt then
		local _, _, m, s = hms(tAt - now)
		tacoPill.Visible = true
		tacoLbl.Text = string.format("TACO EVENT IN  %02d:%02d", m, s)
	end
end)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">PBConfig</string><ProtectedString name="Source"><![CDATA[-- PBConfig (ModuleScript) | vai para ReplicatedStorage automaticamente
-- Coins = preco em moedas (ganhas nas partidas) | Robux + ProductId = Developer Product
-- (crie em Creator Dashboard > Monetization > Developer Products e cole o ID em ProductId)
-- Pattern = textura da bomba: stripes | dots | stars | skull   (Accent = cor da textura)
local C = {}

C.Skins = {
	{ Id = "classic", Name = "Classica", Base = Color3.fromRGB(25, 25, 30), Flash = Color3.fromRGB(255, 40, 30) },
	{ Id = "capybara", Name = "Capivara", Free = true, Base = Color3.fromRGB(156, 110, 72), Flash = Color3.fromRGB(255, 150, 40), Fuse = Color3.fromRGB(60, 160, 70), Pattern = "dots", Accent = Color3.fromRGB(115, 78, 48) },
	{ Id = "melon", Name = "Melancia", Coins = 100, Base = Color3.fromRGB(40, 150, 60), Flash = Color3.fromRGB(255, 70, 90), Fuse = Color3.fromRGB(255, 255, 255), Pattern = "stripes", Accent = Color3.fromRGB(20, 90, 35) },
	{ Id = "ice", Name = "Gelo", Coins = 250, Base = Color3.fromRGB(150, 220, 255), Flash = Color3.fromRGB(255, 255, 255), Mat = Enum.Material.Glass, Effect = "sparkles", Pattern = "dots", Accent = Color3.fromRGB(255, 255, 255) },
	{ Id = "burger", Name = "Hamburguer", Coins = 500, Base = Color3.fromRGB(215, 150, 70), Flash = Color3.fromRGB(255, 220, 120), Pattern = "dots", Accent = Color3.fromRGB(250, 235, 200) },
	{ Id = "pink", Name = "Chiclete", Coins = 400, Robux = 39, ProductId = 0, Base = Color3.fromRGB(255, 130, 200), Flash = Color3.fromRGB(255, 255, 120), Pattern = "dots", Accent = Color3.fromRGB(255, 255, 255) },
	{ Id = "skull", Name = "Caveira", Coins = 600, Base = Color3.fromRGB(238, 238, 228), Flash = Color3.fromRGB(255, 60, 60), Pattern = "skull", Accent = Color3.fromRGB(25, 25, 30) },
	{ Id = "brasil", Name = "Brasil", Coins = 700, Robux = 59, ProductId = 0, Base = Color3.fromRGB(0, 156, 59), Flash = Color3.fromRGB(254, 223, 0), Fuse = Color3.fromRGB(254, 223, 0), Pattern = "stripes", Accent = Color3.fromRGB(254, 223, 0) },
	{ Id = "gold", Name = "Ouro", Coins = 800, Robux = 79, ProductId = 0, Base = Color3.fromRGB(255, 199, 40), Flash = Color3.fromRGB(255, 255, 255), Mat = Enum.Material.Metal, Effect = "sparkles", Pattern = "stripes", Accent = Color3.fromRGB(200, 140, 20) },
	{ Id = "dino", Name = "Dino", Coins = 900, Robux = 69, ProductId = 0, Base = Color3.fromRGB(70, 160, 60), Flash = Color3.fromRGB(255, 230, 80), Pattern = "dots", Accent = Color3.fromRGB(40, 100, 35) },
	{ Id = "galaxy", Name = "Galaxia", Coins = 1500, Robux = 99, ProductId = 0, Base = Color3.fromRGB(60, 30, 120), Flash = Color3.fromRGB(190, 110, 255), Effect = "sparkles", Pattern = "stars", Accent = Color3.fromRGB(255, 255, 160) },
	{ Id = "rainbow", Name = "Arco-iris", Coins = 3000, Robux = 199, ProductId = 0, Base = Color3.fromRGB(255, 255, 255), Flash = Color3.fromRGB(255, 255, 255), Rainbow = true, Pattern = "stars", Accent = Color3.fromRGB(255, 255, 255) },
	{ Id = "dragon", Name = "Dragao", Coins = 5000, Robux = 299, ProductId = 0, Base = Color3.fromRGB(120, 20, 20), Flash = Color3.fromRGB(255, 160, 40), Effect = "fire", Pattern = "dots", Accent = Color3.fromRGB(255, 160, 40) },
}

-- Pacotes de moedas (Robux)
C.CoinPacks = {
	{ Id = "p1", Name = "Punhado de Moedas", Coins = 500,   Robux = 25,  ProductId = 0 },
	{ Id = "p2", Name = "Saco de Moedas",    Coins = 2500,  Robux = 99,  ProductId = 0 },
	{ Id = "p3", Name = "Bau de Moedas",     Coins = 10000, Robux = 299, ProductId = 0 },
}

-- Combo de hamburgueres duplos do Chef (Robux): super velocidade na partida
C.BurgerPack = { Name = "Combo 3 Hamburgueres Duplos", Count = 3, Robux = 39, ProductId = 0 }

-- Eventos (Taco Event a cada 10 min + contagem e evento de Natal)
C.Events = {
	TacoInterval = 600,        -- segundos entre Taco Events (teste rapido: 30)
	TacoDuration = 30,         -- duracao do evento
	TacoRate = 3,              -- tacos por segundo
	TacoCoins = 2,             -- moedas por taco coletado
	TacoMaxPerPlayer = 30,     -- limite por jogador em cada evento
	ChristmasYear = 2026, ChristmasMonth = 12, ChristmasDay = 25,
	UtcOffsetHours = 0,        -- fuso: 0 = meia-noite UTC; -3 = meia-noite em Brasilia
	ChristmasDuration = 24 * 3600, -- quanto tempo o evento de Natal fica ativo
	TestChristmas = false,     -- true: o Natal comeca 20s apos o servidor abrir e dura 3 min (para testar no Studio)
	MusicId = "",              -- opcional: rbxassetid://... de uma musica de Natal sua (se vazio, toca "Jingle Bells" gerado com notas)
	NoteSound = "rbxasset://sounds/electronicpingshort.wav",
	NoteBase = -5,             -- afinacao do som de notas
}

return C
]]></ProtectedString></Properties></Item></Item></Item></roblox>