local frng = Random.new(11)
for _ = 1, 140 do
	local x, z = frng:NextInteger(-70, 70), frng:NextInteger(-70, 70)
	if math.abs(x) >= 9 and math.abs(z + 36) >= 9 and z >= -40 and math.abs(z + 10) >= 6 then
		local stem = P(map, "Stem", Vector3.new(0.4, 1.6, 0.4), CFrame.new(x, 0.8, z), Color3.fromRGB(60, 150, 60))
		local head = P(map, "Flower", Vector3.new(1.4, 1.4, 1.4), CFrame.new(x, 2.3, z), Color3.fromHSV(frng:NextNumber(), 0.55, 1))
		stem.CanCollide, head.CanCollide = false, false
	end
end

local function makeChef()
	local m = Instance.new("Model")
	m.Name = "Chef"
	local function part(nm, sz, off, col)
		local p = Instance.new("Part")
		p.Name, p.Size, p.Color, p.Material = nm, sz, col, PLASTIC
		p.Anchored, p.CanCollide = true, false
		p.CFrame = CFrame.new(off)
		for _, f in ipairs(FACES) do p[f] = Enum.SurfaceType.Studs end
		p.Parent = m
		return p
	end
	local W, SK = Color3.new(1, 1, 1), Color3.fromRGB(240, 190, 150)
	local torso = part("Torso", Vector3.new(3.2, 3.4, 1.8), Vector3.new(0, 4.3, 0), W)
	m.PrimaryPart = torso
	part("Apron", Vector3.new(3.3, 2.4, 0.3), Vector3.new(0, 3.8, -1), Color3.fromRGB(225, 225, 235))
	part("Legs", Vector3.new(3, 2.6, 1.6), Vector3.new(0, 1.3, 0), Color3.fromRGB(60, 60, 75))
	part("Head", Vector3.new(2, 2, 2), Vector3.new(0, 7, 0), SK)
	part("HatBand", Vector3.new(2.5, 0.6, 2.5), Vector3.new(0, 8, 0), Color3.fromRGB(235, 235, 240))
	part("Hat", Vector3.new(2.4, 2.6, 2.4), Vector3.new(0, 9.3, 0), W)
	part("Mustache", Vector3.new(1.4, 0.3, 0.3), Vector3.new(0, 6.6, -1.05), Color3.fromRGB(40, 30, 25))
	for _, sx in ipairs({ -0.5, 0.5 }) do part("Eye", Vector3.new(0.3, 0.3, 0.2), Vector3.new(sx, 7.2, -1.05), Color3.fromRGB(20, 20, 20)) end
	part("ArmL", Vector3.new(0.9, 3, 0.9), Vector3.new(-2.1, 4.2, 0), W)
	local arm = {}
	arm[#arm + 1] = part("ArmR", Vector3.new(0.9, 3, 0.9), Vector3.new(2.1, 4.2, 0), W)
	arm[#arm + 1] = part("BunBottom", Vector3.new(1.6, 0.4, 1.6), Vector3.new(2.1, 2.4, -1.1), Color3.fromRGB(215, 150, 70))
	arm[#arm + 1] = part("Patty", Vector3.new(1.7, 0.35, 1.7), Vector3.new(2.1, 2.78, -1.1), Color3.fromRGB(95, 55, 30))
	arm[#arm + 1] = part("Lettuce", Vector3.new(1.8, 0.2, 1.8), Vector3.new(2.1, 3.05, -1.1), Color3.fromRGB(80, 200, 70))
	arm[#arm + 1] = part("BunTop", Vector3.new(1.6, 0.7, 1.6), Vector3.new(2.1, 3.5, -1.1), Color3.fromRGB(225, 160, 80))
	local rel = {}
	for _, p in ipairs(arm) do rel[p] = torso.CFrame:Inverse() * p.CFrame end
	return m, arm, rel
end

-- ===== arenas =====
local SIZE = 120
local arenas = {}
local phase, status = "waiting", "Esperando jogadores..."
local alive = {}
local boost = {}
local holder, bombPart, holderSkin, bombEnd, bombTotal, passLock = nil, nil, nil, 0, 1, 0
local conns = {}
local currentArena, nextArena, lastArena
local botArena
local dinoArena, dinoActive, trexRoot, trexReset, chefNPC, chefAnimate, beachArena, parkArena, xmasActive
local botByModel = {}
local function isBot(e) return typeof(e) == "table" end

local function newArena(name, center, clock, special)
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = map
	local a = { Name = name, Center = center, Folder = f, Clock = clock, Spawns = {} }
	a.box = function(nm, size, off, color, mat, transp, ry)
		return P(f, nm, size, CFrame.new(center + off) * CFrame.Angles(0, ry or 0, 0), color, mat, transp)
	end
	if not special then arenas[#arenas + 1] = a end
	return a
end
local function walls(a)
	for _, d in ipairs({ { 0, SIZE / 2 + 1, SIZE + 4, 2 }, { 0, -SIZE / 2 - 1, SIZE + 4, 2 }, { SIZE / 2 + 1, 0, 2, SIZE + 4 }, { -SIZE / 2 - 1, 0, 2, SIZE + 4 } }) do
		a.box("Wall", Vector3.new(d[3], 40, d[4]), Vector3.new(d[1], 20, d[2]), Color3.fromRGB(190, 220, 255), PLASTIC, 0.55)
	end
end
local eliminate -- definido mais abaixo
local function hazard(part, why)
	part.CanCollide = false
	part.Touched:Connect(function(hit)
		if phase ~= "playing" then return end
		local m = hit:FindFirstAncestorOfClass("Model")
		local pl = m and (Players:GetPlayerFromCharacter(m) or botByModel[m])
		if pl and alive[pl] then eliminate(pl, why) end
	end)
end

-- ===== helpers de decoracao =====
local BONE = Color3.fromRGB(240, 235, 215)
local function deco(p) p.CanCollide, p.CanTouch, p.CanQuery, p.CastShadow = false, false, false, false return p end
local function weld(p0, p1)
	local w = Instance.new("WeldConstraint")
	w.Part0, w.Part1, w.Parent = p0, p1, p0
end
local function plaque(part, text, faces, cw, ch)
	for _, f in ipairs(faces) do
		local sg = Instance.new("SurfaceGui")
		sg.Face, sg.CanvasSize, sg.Parent = f, Vector2.new(cw, ch), part
		local t = Instance.new("TextLabel")
		t.Size, t.Position, t.BackgroundTransparency, t.Text, t.TextScaled = UDim2.new(1, -20, 1, -20), UDim2.new(0, 10, 0, 10), 1, text, true
		t.Font, t.TextColor3, t.TextStrokeTransparency, t.TextStrokeColor3 = Enum.Font.FredokaOne, Color3.new(1, 1, 1), 0, Color3.fromRGB(60, 20, 20)
		t.Parent = sg
	end
end
local function tree(a, x, z, h, leaf)
	a.box("Trunk", Vector3.new(2, h, 2), Vector3.new(x, h / 2, z), Color3.fromRGB(120, 80, 40))
	a.box("Leaves", Vector3.new(9, 6, 9), Vector3.new(x, h + 2, z), leaf or Color3.fromRGB(46, 150, 60))
	return a.box("Leaves", Vector3.new(6, 4, 6), Vector3.new(x, h + 6, z), leaf or Color3.fromRGB(70, 180, 70))
end
local function palm(a, x, z, h)
	h = h or 14
	a.box("Trunk", Vector3.new(1.6, h, 1.6), Vector3.new(x, h / 2, z), Color3.fromRGB(150, 110, 60))
	for i = 0, 5 do
		local ang = i * math.pi / 3
		a.box("Frond", Vector3.new(7, 0.5, 2), Vector3.new(x + math.cos(ang) * 3.2, h + 0.5, z + math.sin(ang) * 3.2), Color3.fromRGB(40, 160, 70), PLASTIC, 0, -ang)
	end
end

-- 1) PRE-HISTORIA: vulcao, lava, esqueleto de dinossauro, ninhos com ovos, samambaias
do
	local a = newArena("Pre-Historia", Vector3.new(-300, 0, 250), 17)
	a.box("Floor", Vector3.new(SIZE, 2, SIZE), Vector3.new(0, -1, 0), Color3.fromRGB(125, 150, 70))
	walls(a)
	local tiers = { { 36, Color3.fromRGB(95, 85, 90) }, { 28, Color3.fromRGB(80, 72, 78) }, { 20, Color3.fromRGB(70, 62, 68) }, { 12, Color3.fromRGB(150, 70, 45) } }
	for i, t in ipairs(tiers) do
		a.box("Volcano" .. i, Vector3.new(t[1], 4, t[1]), Vector3.new(0, (i - 1) * 4 + 2, 0), t[2])
	end
	hazard(a.box("LavaTop", Vector3.new(6, 0.5, 6), Vector3.new(0, 16.25, 0), Color3.fromRGB(255, 110, 20)), " caiu no vulcao!")
	for _, sx in ipairs({ -26, 26 }) do
		for _, sz in ipairs({ -26, 26 }) do
			hazard(a.box("Lava", Vector3.new(12, 0.6, 12), Vector3.new(sx, 0.3, sz), Color3.fromRGB(255, 100, 20)), " caiu na lava!")
			deco(a.box("LavaGlow", Vector3.new(4, 5, 4), Vector3.new(sx, 3, sz), Color3.fromRGB(255, 170, 60), Enum.Material.Neon, 0.7))
		end
	end
	for _, t in ipairs({ { -40, 0 }, { 40, 0 }, { 0, 40 }, { 0, -40 }, { -38, 38 }, { 38, -38 }, { -38, -14 }, { 38, 14 } }) do
		tree(a, t[1], t[2], 10, Color3.fromRGB(46, 140, 60))
	end
	for _, b in ipairs({ { -10, -32 }, { 10, 32 }, { 32, -6 }, { -32, 6 } }) do
		a.box("Boulder", Vector3.new(8, 6, 8), Vector3.new(b[1], 3, b[2]), Color3.fromRGB(130, 130, 135))
		a.box("Boulder", Vector3.new(5, 4, 5), Vector3.new(b[1] + 3, 2, b[2] + 4), Color3.fromRGB(110, 110, 118))
	end
	-- esqueleto
	for i = -2, 2 do
		a.box("Rib", Vector3.new(0.8, 5, 0.8), Vector3.new(i * 3, 2.5, -27), BONE)
		a.box("Rib", Vector3.new(0.8, 5, 0.8), Vector3.new(i * 3, 2.5, -21), BONE)
		a.box("RibTop", Vector3.new(0.8, 0.8, 6.8), Vector3.new(i * 3, 5.2, -24), BONE)
	end
	a.box("Spine", Vector3.new(16, 0.9, 0.9), Vector3.new(0, 5.8, -24), BONE)
	a.box("Skull", Vector3.new(4, 3, 5), Vector3.new(-11, 1.5, -24), BONE)
	for i = -1, 1 do deco(a.box("Tooth", Vector3.new(0.4, 0.8, 0.4), Vector3.new(-13.2, 0.4, -24 + i * 1.4), Color3.new(1, 1, 1))) end
	-- ninhos com ovos
	for _, n in ipairs({ { -46, -46 }, { 46, -46 }, { -46, 46 }, { 46, 46 } }) do
		for _, d in ipairs({ { 0, 3, 7, 1 }, { 0, -3, 7, 1 }, { 3, 0, 1, 7 }, { -3, 0, 1, 7 } }) do
			a.box("Nest", Vector3.new(d[3], 1, d[4]), Vector3.new(n[1] + d[1], 0.5, n[2] + d[2]), Color3.fromRGB(150, 110, 60))
		end
		for k = -1, 1 do
			a.box("Egg", Vector3.new(2, 3, 2), Vector3.new(n[1] + k * 1.8, 1.5, n[2]), Color3.fromHSV(0.1 + k * 0.05, 0.25, 1))
		end
	end
	for i, f in ipairs({ { -20, 34 }, { 20, -34 }, { -34, -20 }, { 34, 22 }, { -22, -36 }, { 24, 36 }, { 12, -44 }, { -14, 46 } }) do
		for k = 0, 2 do
			deco(a.box("Fern", Vector3.new(4, 1.2, 1), Vector3.new(f[1], 0.6, f[2]), Color3.fromRGB(50, 170, 70), PLASTIC, 0, k * math.pi / 3))
		end
	end
	for _, g in ipairs({ { -34, -2 }, { 34, 2 } }) do
		deco(a.box("Steam", Vector3.new(3, 12, 3), Vector3.new(g[1], 6, g[2]), Color3.new(1, 1, 1), PLASTIC, 0.6))
	end
	for i = 0, 15 do
		local ang = i / 16 * math.pi * 2
		a.Spawns[#a.Spawns + 1] = a.Center + Vector3.new(math.cos(ang) * 50, 4, math.sin(ang) * 50)
	end
end

-- 2) LAGO: ilha, pedras, pontes, vitorias-regias, barco e penhascos com palmeiras
do
	local a = newArena("Lago", Vector3.new(0, 0, 300), 11)
	a.box("Lakebed", Vector3.new(SIZE, 2, SIZE), Vector3.new(0, -6, 0), Color3.fromRGB(220, 200, 140))
	walls(a)
	hazard(a.box("Water", Vector3.new(SIZE, 4, SIZE), Vector3.new(0, -2.6, 0), Color3.fromRGB(60, 140, 230), PLASTIC, 0.35), " caiu no lago!")
	a.box("Island", Vector3.new(40, 4, 40), Vector3.new(0, -2, 0), Color3.fromRGB(90, 175, 80))
	local stones = {}
	for i = 0, 5 do
		local ang = math.rad(i * 60)
		local pos = Vector3.new(math.cos(ang) * 38, 0, math.sin(ang) * 38)
		stones[#stones + 1] = pos
		a.box("Stone", Vector3.new(14, 4, 14), pos + Vector3.new(0, -2, 0), Color3.fromRGB(150, 150, 160))
		a.box("Bridge", Vector3.new(18, 1, 6), Vector3.new(math.cos(ang) * 25, -0.5, math.sin(ang) * 25), Color3.fromRGB(170, 120, 70), PLASTIC, 0, -ang)
		for _, s in ipairs({ -3.4, 3.4 }) do
			local rx, rz = math.cos(ang + math.pi / 2) * s, math.sin(ang + math.pi / 2) * s
			a.box("Rail", Vector3.new(18, 0.4, 0.4), Vector3.new(math.cos(ang) * 25 + rx, 1.2, math.sin(ang) * 25 + rz), Color3.fromRGB(120, 80, 45), PLASTIC, 0, -ang)
		end
		for k = -1, 1, 2 do
			local ra = ang + 0.5 * k
			deco(a.box("Reed", Vector3.new(0.5, 5, 0.5), Vector3.new(math.cos(ra) * 44, 2.5, math.sin(ra) * 44), Color3.fromRGB(110, 170, 60)))
		end
	end
	for _, t in ipairs({ { -12, -12 }, { 12, -12 }, { -12, 12 }, { 12, 12 } }) do
		tree(a, t[1], t[2], 6, Color3.fromRGB(56, 160, 60))
	end
	a.box("Fountain", Vector3.new(8, 1.2, 8), Vector3.new(0, 0.6, 0), Color3.fromRGB(150, 150, 160))
	a.box("FountainWater", Vector3.new(6, 0.4, 6), Vector3.new(0, 1.3, 0), Color3.fromRGB(100, 190, 255), PLASTIC, 0.3)
	-- vitorias-regias como plataformas extras
	for i = 0, 5 do
		local ang = math.rad(i * 60 + 30)
		a.box("LilyPad", Vector3.new(4.5, 0.2, 4.5), Vector3.new(math.cos(ang) * 32, -0.4, math.sin(ang) * 32), Color3.fromRGB(70, 170, 70))
		deco(a.box("Flower", Vector3.new(1, 0.8, 1), Vector3.new(math.cos(ang) * 32, 0.2, math.sin(ang) * 32), Color3.fromRGB(255, 150, 200)))
	end
	-- barco
	local bx, bz = 22, 24
	a.box("Hull", Vector3.new(9, 1.5, 3.6), Vector3.new(bx, 0.15, bz), Color3.fromRGB(150, 95, 50), PLASTIC, 0, -0.5)
	a.box("Deck", Vector3.new(7, 0.3, 3), Vector3.new(bx, 1.0, bz), Color3.fromRGB(190, 140, 80), PLASTIC, 0, -0.5)
	a.box("Mast", Vector3.new(0.5, 8, 0.5), Vector3.new(bx, 4.5, bz), Color3.fromRGB(110, 75, 40))
	deco(a.box("Sail", Vector3.new(0.3, 5, 4), Vector3.new(bx, 5.5, bz), Color3.new(1, 1, 1), PLASTIC, 0, -0.5))
	-- penhascos nos cantos
	for _, c in ipairs({ { -52, -52 }, { 52, -52 }, { -52, 52 }, { 52, 52 } }) do
		a.box("Cliff", Vector3.new(14, 10, 14), Vector3.new(c[1], 3, c[2]), Color3.fromRGB(130, 125, 120))
		a.box("CliffTop", Vector3.new(10, 3, 10), Vector3.new(c[1], 9.5, c[2]), Color3.fromRGB(90, 170, 80))
		palm(a, c[1], c[2], 8)
	end
	for _, off in ipairs({ Vector3.new(-3, 4, -3), Vector3.new(3, 4, 3), Vector3.new(-3, 4, 3), Vector3.new(3, 4, -3) }) do
		for _, s in ipairs(stones) do a.Spawns[#a.Spawns + 1] = a.Center + s + off end
	end
end

-- 3) CIDADE: ruas, predios com janelas, faixas, onibus, carros, postes, outdoor
do
	local a = newArena("Cidade", Vector3.new(300, 0, 250), 19)
	a.box("Floor", Vector3.new(SIZE, 2, SIZE), Vector3.new(0, -1, 0), Color3.fromRGB(70, 72, 80))
	walls(a)
	deco(a.box("Line", Vector3.new(SIZE - 4, 0.2, 1), Vector3.new(0, 0.1, 0), Color3.fromRGB(255, 220, 60)))
	deco(a.box("Line", Vector3.new(1, 0.2, SIZE - 4), Vector3.new(0, 0.1, 0), Color3.fromRGB(255, 220, 60)))
	local wrng = Random.new(5)
	local function windows(bx, bz, h)
		for r = 1, math.max(1, math.floor((h - 2) / 6)) do
			local y = (r - 1) * 6 + 4
			for c = -1, 1 do
				local lit = wrng:NextNumber() < 0.5
				local col = lit and Color3.fromRGB(255, 235, 150) or Color3.fromRGB(150, 200, 235)
				local mat = lit and Enum.Material.Neon or PLASTIC
				for _, f in ipairs({ 12.15, -12.15 }) do
					deco(a.box("Window", Vector3.new(3, 3, 0.3), Vector3.new(bx + c * 7, y, bz + f), col, mat))
					deco(a.box("Window", Vector3.new(0.3, 3, 3), Vector3.new(bx + f, y, bz + c * 7), col, mat))
				end
			end
		end
	end
	local blds = { { 24, 24, 6 }, { -24, -24, 6 }, { 24, -24, 30 }, { -24, 24, 24 } }
	for i, b in ipairs(blds) do
		a.box("Building", Vector3.new(24, b[3], 24), Vector3.new(b[1], b[3] / 2, b[2]), Color3.fromHSV(i / 4, 0.45, 0.95))
		a.box("RoofEdge", Vector3.new(25, 0.8, 25), Vector3.new(b[1], b[3] + 0.4, b[2]), Color3.fromRGB(80, 80, 90))
		a.box("AC", Vector3.new(4, 2, 4), Vector3.new(b[1] + 6, b[3] + 1.8, b[2] + 6), Color3.fromRGB(170, 175, 185))
		a.box("Antenna", Vector3.new(0.4, 6, 0.4), Vector3.new(b[1] - 6, b[3] + 3.8, b[2] - 6), Color3.fromRGB(90, 90, 100))
		windows(b[1], b[2], b[3])
	end
	local bb = a.box("Billboard", Vector3.new(16, 6, 1), Vector3.new(24, 35, -24), Color3.fromRGB(30, 30, 60))
	sign(bb, "PASSA BOMBA CITY", 0, 420, 110)
	for _, dx in ipairs({ -6, 6 }) do a.box("BillboardPost", Vector3.new(0.8, 5, 0.8), Vector3.new(24 + dx, 31.8, -24), Color3.fromRGB(90, 90, 100)) end
	for _, c in ipairs({ { 0, 24, 5, 10, Color3.fromRGB(220, 60, 60) }, { 0, -24, 5, 10, Color3.fromRGB(60, 120, 220) }, { 24, 0, 10, 5, Color3.fromRGB(240, 200, 60) }, { -24, 0, 10, 5, Color3.fromRGB(80, 200, 120) } }) do
		a.box("Car", Vector3.new(c[3], 2.2, c[4]), Vector3.new(c[1], 1.1, c[2]), c[5])
		deco(a.box("CarTop", Vector3.new(c[3] - 1, 1.2, c[4] - 4), Vector3.new(c[1], 2.8, c[2]), Color3.fromRGB(170, 215, 245)))
	end
	for _, l in ipairs({ { -10, -10 }, { 10, -10 }, { -10, 10 }, { 10, 10 } }) do
		a.box("Post", Vector3.new(1, 12, 1), Vector3.new(l[1], 6, l[2]), Color3.fromRGB(90, 90, 100))
		a.box("Lamp", Vector3.new(3, 1, 3), Vector3.new(l[1], 12.5, l[2]), Color3.fromRGB(255, 240, 150), Enum.Material.Neon)
	end
	for _, v in ipairs({ 16, -16 }) do
		for i = -4, 4 do
			deco(a.box("Crosswalk", Vector3.new(1.2, 0.2, 5), Vector3.new(i * 2.2, 0.1, v), Color3.new(1, 1, 1)))
			deco(a.box("Crosswalk", Vector3.new(5, 0.2, 1.2), Vector3.new(v, 0.1, i * 2.2), Color3.new(1, 1, 1)))
		end
	end
	a.box("Fountain", Vector3.new(10, 1.5, 10), Vector3.new(0, 0.75, 0), Color3.fromRGB(150, 150, 165))
	a.box("FountainWater", Vector3.new(8, 0.4, 8), Vector3.new(0, 1.6, 0), Color3.fromRGB(110, 200, 255), PLASTIC, 0.3)
	a.box("FountainTop", Vector3.new(3, 6, 3), Vector3.new(0, 4, 0), Color3.fromRGB(220, 220, 230))
	-- onibus
	a.box("Bus", Vector3.new(16, 4, 6), Vector3.new(-10, 2.5, -44), Color3.fromRGB(250, 200, 40))
	deco(a.box("BusWindows", Vector3.new(14, 1.4, 6.2), Vector3.new(-10, 3.4, -44), Color3.fromRGB(150, 200, 235)))
	for _, wx in ipairs({ -14, -6 }) do
		for _, wz in ipairs({ -47, -41 }) do deco(a.box("Wheel", Vector3.new(2, 2, 0.8), Vector3.new(wx, 1, wz), Color3.fromRGB(30, 30, 35))) end
	end
	-- floreiras nos cantos
	for _, c in ipairs({ { -38, -38 }, { 38, -38 }, { -38, 38 }, { 38, 38 } }) do
		a.box("Planter", Vector3.new(5, 1.5, 5), Vector3.new(c[1], 0.75, c[2]), Color3.fromRGB(150, 90, 60))
		tree(a, c[1], c[2], 5, Color3.fromRGB(70, 175, 80))
	end
	for _, k in ipairs({ -40, -20, 0, 20, 40 }) do
		for _, v in ipairs({ Vector3.new(k, 4, 48), Vector3.new(k, 4, -48), Vector3.new(48, 4, k), Vector3.new(-48, 4, k) }) do
			a.Spawns[#a.Spawns + 1] = a.Center + v
		end
	end
end

-- 5) RESTAURANTE: salao com mesas, cozinha com fogao quente, chef e hamburguer gigante
do
	local a = newArena("Restaurante", Vector3.new(-300, 0, -300), 13)
	for ix = 0, 11 do
		for iz = 0, 11 do
			a.box("Tile", Vector3.new(10, 2, 10), Vector3.new(-55 + ix * 10, -1, -55 + iz * 10), ((ix + iz) % 2 == 0) and Color3.fromRGB(245, 240, 230) or Color3.fromRGB(70, 70, 80))
		end
	end
	for _, d in ipairs({ { 0, SIZE / 2 + 1, SIZE + 4, 2 }, { 0, -SIZE / 2 - 1, SIZE + 4, 2 }, { SIZE / 2 + 1, 0, 2, SIZE + 4 }, { -SIZE / 2 - 1, 0, 2, SIZE + 4 } }) do
		a.box("Wall", Vector3.new(d[3], 32, d[4]), Vector3.new(d[1], 16, d[2]), Color3.fromRGB(255, 232, 190))
		local bs = (d[3] > d[4]) and Vector3.new(d[3], 4, d[4] + 0.4) or Vector3.new(d[3] + 0.4, 4, d[4])
		a.box("Band", bs, Vector3.new(d[1], 3, d[2]), Color3.fromRGB(190, 50, 45))
	end
	deco(a.box("Carpet", Vector3.new(12, 0.2, 80), Vector3.new(0, 0.1, 6), Color3.fromRGB(170, 30, 40)))
	local function dine(x, z)
		a.box("TableLeg", Vector3.new(1, 3.2, 1), Vector3.new(x, 1.6, z), Color3.fromRGB(90, 60, 40))
		a.box("Table", Vector3.new(6, 0.6, 6), Vector3.new(x, 3.5, z), Color3.fromRGB(200, 55, 50))
		deco(a.box("Plate", Vector3.new(1.8, 0.2, 1.8), Vector3.new(x, 3.9, z), Color3.new(1, 1, 1)))
		deco(a.box("Candle", Vector3.new(0.4, 0.8, 0.4), Vector3.new(x + 1.6, 4.1, z + 1.6), Color3.fromRGB(255, 240, 150), Enum.Material.Neon))
		for _, c in ipairs({ { -4.5, 0 }, { 4.5, 0 }, { 0, -4.5 }, { 0, 4.5 } }) do
			a.box("Seat", Vector3.new(2.2, 1.6, 2.2), Vector3.new(x + c[1], 0.8, z + c[2]), Color3.fromRGB(150, 100, 60))
			a.box("ChairBack", Vector3.new(c[1] ~= 0 and 0.5 or 2.2, 2.4, c[2] ~= 0 and 0.5 or 2.2), Vector3.new(x + c[1] * 1.25, 2.8, z + c[2] * 1.25), Color3.fromRGB(120, 80, 45))
		end
	end
	for _, x in ipairs({ -36, -12, 12, 36 }) do
		for _, z in ipairs({ -6, 20 }) do
			if not (math.abs(x) < 20 and z == -6) then dine(x, z) end
		end
	end
	-- cozinha
	local STEEL = Color3.fromRGB(200, 205, 215)
	a.box("Counter", Vector3.new(44, 4, 5), Vector3.new(0, 2, -42), STEEL)
	a.box("CounterTop", Vector3.new(45, 0.5, 5.6), Vector3.new(0, 4.25, -42), Color3.fromRGB(235, 235, 240))
	for _, x in ipairs({ -12, 12 }) do
		a.box("Stove", Vector3.new(7, 0.5, 4), Vector3.new(x, 4.75, -42), Color3.fromRGB(50, 50, 55))
		hazard(a.box("Burner", Vector3.new(2.4, 0.4, 2.4), Vector3.new(x, 5.15, -42), Color3.fromRGB(255, 110, 30), Enum.Material.Neon), " tocou no fogao quente!")
	end
	for i = -1, 1 do deco(a.box("Plate", Vector3.new(2, 0.2, 2), Vector3.new(i * 4, 4.6, -42), Color3.new(1, 1, 1))) end
	a.box("Fridge", Vector3.new(6, 10, 5), Vector3.new(-46, 5, -56), STEEL)
	a.box("Fridge", Vector3.new(6, 10, 5), Vector3.new(-39, 5, -56), STEEL)
	a.box("PrepTable", Vector3.new(14, 3.5, 5), Vector3.new(30, 1.75, -54), STEEL)
	a.box("Shelf", Vector3.new(18, 1, 3), Vector3.new(30, 8, -58.5), Color3.fromRGB(150, 100, 60))
	for i = -3, 3 do deco(a.box("Pot", Vector3.new(1.6, 1.4, 1.6), Vector3.new(30 + i * 2.4, 9.2, -58.5), Color3.fromRGB(90, 90, 100))) end
	-- hamburguer gigante na parede
	local by = 14
	a.box("BunBottom", Vector3.new(14, 2, 3), Vector3.new(0, by, -59), Color3.fromRGB(215, 150, 70))
	a.box("Patty", Vector3.new(15, 2, 3.4), Vector3.new(0, by + 2, -59), Color3.fromRGB(95, 55, 30))
	a.box("Lettuce", Vector3.new(16, 1, 3.6), Vector3.new(0, by + 3.5, -59), Color3.fromRGB(80, 200, 70))
	a.box("Cheese", Vector3.new(15, 0.7, 3.4), Vector3.new(0, by + 4.4, -59), Color3.fromRGB(255, 205, 50))
	a.box("BunTop", Vector3.new(14, 3, 3), Vector3.new(0, by + 6.3, -59), Color3.fromRGB(225, 160, 80))
	for i = -3, 3 do deco(a.box("Seed", Vector3.new(0.8, 0.3, 0.8), Vector3.new(i * 1.8, by + 7.9, -59), Color3.fromRGB(250, 235, 200))) end
	-- cardapio
	local menu = a.box("Menu", Vector3.new(13, 8, 0.6), Vector3.new(-24, 9, -59.4), Color3.fromRGB(40, 55, 45))
	local sg = Instance.new("SurfaceGui")
	sg.Face, sg.CanvasSize, sg.Parent = Enum.NormalId.Back, Vector2.new(650, 400), menu
	local mt = Instance.new("TextLabel")
	mt.Size, mt.BackgroundTransparency, mt.TextScaled, mt.Font = UDim2.new(1, -20, 1, -20), 1, true, Enum.Font.FredokaOne
	mt.Position, mt.TextColor3 = UDim2.new(0, 10, 0, 10), Color3.fromRGB(255, 245, 210)
	mt.Text = "MENU\nHamburguer  " .. CFG.BurgerCoins .. " moedas\nVelocidade +35% por 8s\nFale com o Chef!"
	mt.Parent = sg
	-- chef
	local chef, armGroup, rel = makeChef()
	chef.Parent = a.Folder
	local chefBase = CFrame.new(a.Center + Vector3.new(0, 4.3, -48)) * CFrame.Angles(0, math.pi, 0)
	chef:PivotTo(chefBase)
	chefNPC = chef
	sign(chef.PrimaryPart, "Chef Pierre", 6, 260, 60)
	chefAnimate = function(t)
		local base = chefBase * CFrame.new(0, math.abs(math.sin(t * 2)) * 0.25, 0)
		chef:PivotTo(base)
		local sh = CFrame.new(2.1, 1.4, 0)
		local rot = CFrame.Angles(math.sin(t * 4) * 0.9, 0, 0)
		for _, p in ipairs(armGroup) do p.CFrame = base * sh * rot * sh:Inverse() * rel[p] end
	end
	-- decoracao
	for _, c in ipairs({ { -55, -55 }, { 55, -55 }, { -55, 55 }, { 55, 55 } }) do
		a.box("Pot", Vector3.new(2.4, 1.8, 2.4), Vector3.new(c[1], 0.9, c[2]), Color3.fromRGB(190, 100, 60))
		deco(a.box("Plant", Vector3.new(4, 4, 4), Vector3.new(c[1], 3.8, c[2]), Color3.fromRGB(50, 160, 70)))
	end
	for _, l in ipairs({ { 0, 9 }, { -24, 9 }, { 24, 9 } }) do
		a.box("LampPost", Vector3.new(0.6, 8, 0.6), Vector3.new(l[1], 4, l[2]), Color3.fromRGB(60, 50, 45))
		deco(a.box("Shade", Vector3.new(2.6, 1.2, 2.6), Vector3.new(l[1], 8.4, l[2]), Color3.fromRGB(255, 225, 140), Enum.Material.Neon))
	end
	for i, k in ipairs({ -30, 0, 30 }) do
		deco(a.box("Frame", Vector3.new(0.4, 5, 8), Vector3.new(59.7, 10, k), Color3.fromHSV(i / 3, 0.5, 1)))
		deco(a.box("Frame", Vector3.new(0.4, 5, 8), Vector3.new(-59.7, 10, k), Color3.fromHSV(i / 3 + 0.15, 0.5, 1)))
	end
	for k = -50, 50, 10 do a.Spawns[#a.Spawns + 1] = a.Center + Vector3.new(k, 4, 50) end
	for _, z in ipairs({ -20, 0, 20, 35 }) do
		a.Spawns[#a.Spawns + 1] = a.Center + Vector3.new(-52, 4, z)
		a.Spawns[#a.Spawns + 1] = a.Center + Vector3.new(52, 4, z)
	end
end

-- 6) BRASIL: morro com casinhas coloridas, campinho de futebol, bandeira, bar e pipas
do
	local a = newArena("Brasil", Vector3.new(300, 0, -300), 16)
	a.box("Floor", Vector3.new(SIZE, 2, SIZE), Vector3.new(0, -1, 0), Color3.fromRGB(120, 175, 80))
	walls(a)
	local COLS = { Color3.fromRGB(240, 150, 60), Color3.fromRGB(80, 150, 220), Color3.fromRGB(250, 215, 70), Color3.fromRGB(90, 190, 110), Color3.fromRGB(240, 130, 170), Color3.fromRGB(205, 100, 70), Color3.fromRGB(150, 110, 200), Color3.fromRGB(235, 235, 225) }
	local terr = { { -19, 18, 4, Color3.fromRGB(190, 165, 125) }, { -37, 18, 8, Color3.fromRGB(175, 150, 110) }, { -53, 14, 12, Color3.fromRGB(160, 135, 98) } }
	for _, t in ipairs(terr) do
		a.box("Terrace", Vector3.new(116, t[3], t[2]), Vector3.new(0, t[3] / 2, t[1]), t[4])
	end
	-- mural na frente do primeiro patamar
	for i = 0, 7 do
		deco(a.box("Mural", Vector3.new(12, 3, 0.4), Vector3.new(-49 + i * 14, 2, -9.8), COLS[i % 8 + 1]))
	end
	local hi = 0
	local function house(x, topY, z, w, d, h)
		hi = hi + 1
		local col = COLS[hi % 8 + 1]
		a.box("House", Vector3.new(w, h, d), Vector3.new(x, topY + h / 2, z), col)
		if hi % 3 == 0 then a.box("Brick", Vector3.new(w + 0.1, 3, d + 0.1), Vector3.new(x, topY + 1.5, z), Color3.fromRGB(190, 95, 70)) end
		a.box("Laje", Vector3.new(w + 1, 0.8, d + 1), Vector3.new(x, topY + h + 0.4, z), Color3.fromRGB(205, 205, 210))
		deco(a.box("Door", Vector3.new(2.6, 5, 0.4), Vector3.new(x - 2, topY + 2.5, z + d / 2 + 0.1), Color3.fromRGB(95, 60, 40)))
		for _, wx in ipairs({ 2.5, 4.5 }) do deco(a.box("Window", Vector3.new(1.8, 2.2, 0.4), Vector3.new(x + wx - 1, topY + 6, z + d / 2 + 0.1), Color3.fromRGB(160, 215, 245))) end
		if hi % 2 == 0 then a.box("CaixaDagua", Vector3.new(3, 3, 3), Vector3.new(x + 3, topY + h + 2.3, z - 2), Color3.fromRGB(70, 130, 200)) end
		if hi % 3 == 1 then a.box("Antenna", Vector3.new(0.4, 6, 0.4), Vector3.new(x - 3, topY + h + 3.8, z + 1), Color3.fromRGB(90, 90, 100)) end
	end
	for _, x in ipairs({ -45, -27, -9, 9, 27, 45 }) do house(x, 4, -19, 12, 11, 9) end
	for _, x in ipairs({ -36, -18, 0, 18, 36 }) do house(x, 8, -37, 12, 11, 9) end
	for _, x in ipairs({ -45, -27, -9, 9, 27, 45 }) do house(x, 12, -53, 12, 10, 9) end
	-- campinho de futebol
	local pz = 32
	a.box("Pitch", Vector3.new(56, 0.4, 34), Vector3.new(0, 0.2, pz), Color3.fromRGB(60, 165, 70))
	for _, l in ipairs({ { 56, 0.5, 0, pz - 17 }, { 56, 0.5, 0, pz + 17 } }) do deco(a.box("Line", Vector3.new(l[1], 0.1, l[2]), Vector3.new(l[3], 0.45, l[4]), Color3.new(1, 1, 1))) end
	for _, x in ipairs({ -28, 0, 28 }) do deco(a.box("Line", Vector3.new(0.5, 0.1, 34), Vector3.new(x, 0.45, pz), Color3.new(1, 1, 1))) end
	for _, s in ipairs({ -1, 1 }) do
		for _, dz in ipairs({ -4.5, 4.5 }) do a.box("GoalPost", Vector3.new(0.6, 5, 0.6), Vector3.new(27.7 * s, 2.5, pz + dz), Color3.new(1, 1, 1)) end
		a.box("Crossbar", Vector3.new(0.6, 0.6, 9.6), Vector3.new(27.7 * s, 5.2, pz), Color3.new(1, 1, 1))
		deco(a.box("Net", Vector3.new(0.2, 5, 9.6), Vector3.new(29.5 * s, 2.5, pz), Color3.new(1, 1, 1), PLASTIC, 0.6))
	end
	deco(a.box("Ball", Vector3.new(1.6, 1.6, 1.6), Vector3.new(0, 1.2, pz), Color3.new(1, 1, 1)))
	-- bandeira do Brasil
	a.box("FlagPole", Vector3.new(0.6, 20, 0.6), Vector3.new(-50, 10, -7), Color3.fromRGB(200, 200, 205))
	a.box("Flag", Vector3.new(14, 9, 0.5), Vector3.new(-43, 15.5, -7), Color3.fromRGB(0, 156, 59))
	P(a.Folder, "Diamond", Vector3.new(6.2, 6.2, 0.6), CFrame.new(a.Center + Vector3.new(-43, 15.5, -7)) * CFrame.Angles(0, 0, math.rad(45)), Color3.fromRGB(254, 223, 0))
	a.box("Globe", Vector3.new(3.2, 3.2, 0.8), Vector3.new(-43, 15.5, -7), Color3.fromRGB(0, 39, 118))
	-- postes e fios
	for _, x in ipairs({ -40, -14, 14, 40 }) do
		a.box("Pole", Vector3.new(0.8, 18, 0.8), Vector3.new(x, 9, -7), Color3.fromRGB(110, 100, 90))
		a.box("Arm", Vector3.new(5, 0.4, 0.4), Vector3.new(x, 16.5, -7), Color3.fromRGB(110, 100, 90))
	end
	for _, w in ipairs({ { -27, 26 }, { 0, 28 }, { 27, 26 } }) do
		deco(a.box("Wire", Vector3.new(w[2], 0.15, 0.15), Vector3.new(w[1], 16.5, -7), Color3.fromRGB(30, 30, 30)))
	end
	for _, p in ipairs({ { -46, 18 }, { 46, 18 }, { -46, 46 }, { 46, 46 } }) do palm(a, p[1], p[2], 13) end
	-- bar
	a.box("BarCounter", Vector3.new(10, 3.5, 4), Vector3.new(46, 1.75, 6), Color3.fromRGB(150, 100, 60))
	for i = 0, 3 do a.box("Awning", Vector3.new(2.6, 0.6, 7), Vector3.new(42.2 + i * 2.6, 9, 6), (i % 2 == 0) and Color3.fromRGB(0, 156, 59) or Color3.fromRGB(254, 223, 0)) end
	for _, dx in ipairs({ -5, 5 }) do a.box("BarPost", Vector3.new(0.8, 9, 0.8), Vector3.new(46 + dx, 4.5, 3), Color3.fromRGB(110, 75, 40)) end
	sign(a.box("BarSign", Vector3.new(9, 2.4, 0.6), Vector3.new(46, 11, 3), Color3.fromRGB(255, 244, 214)), "BAR DO ZE", 0, 300, 70)
	-- pipas
	for i, k in ipairs({ { -30, 26, 10 }, { 20, 30, -2 }, { 40, 22, 28 }, { -12, 28, 24 } }) do
		deco(P(a.Folder, "Kite", Vector3.new(4, 4, 0.2), CFrame.new(a.Center + Vector3.new(k[1], k[2], k[3])) * CFrame.Angles(0, i, math.rad(45)), COLS[i * 2]))
	end
	for k = -50, 50, 10 do a.Spawns[#a.Spawns + 1] = a.Center + Vector3.new(k, 4, 52) end
	for _, z in ipairs({ 10, 30 }) do
		a.Spawns[#a.Spawns + 1] = a.Center + Vector3.new(-52, 4, z)
		a.Spawns[#a.Spawns + 1] = a.Center + Vector3.new(52, 4, z + 14)
	end
end

-- 8) PRAIA DE COPACABANA: a agua NAO mata (so deixa mais lento). Guarda-sois, postos de guarda-vidas, calcadao
do
	local a = newArena("Praia de Copacabana", Vector3.new(600, 0, 0), 15)
	beachArena = a
	a.box("Sand", Vector3.new(SIZE, 2, SIZE), Vector3.new(0, -1, 0), Color3.fromRGB(238, 214, 150))
	walls(a)

	-- mar raso (nao e hazard) com ondas animadas
	deco(a.box("Sea", Vector3.new(SIZE, 1.4, 40), Vector3.new(0, 0.7, -40), Color3.fromRGB(40, 150, 220), PLASTIC, 0.45))
	deco(a.box("WetSand", Vector3.new(SIZE, 0.1, 4), Vector3.new(0, 0.06, -18), Color3.fromRGB(196, 165, 110)))
	local foam = {}
	for i = 1, 3 do
		foam[i] = deco(a.box("Foam", Vector3.new(SIZE - 6, 0.2, 1.6), Vector3.new(0, 1.45, -24 - (i - 1) * 10), Color3.new(1, 1, 1), PLASTIC, 0.2))
	end
	RunS.Heartbeat:Connect(function()
		if currentArena ~= a then return end
		local t = os.clock()
		for i, f in ipairs(foam) do
			f.CFrame = CFrame.new(a.Center.X, 1.45, a.Center.Z - 24 - (i - 1) * 10 + math.sin(t * 1.4 + i * 1.7) * 2.2)
		end
	end)
	for x = -50, 50, 10 do deco(a.box("Buoy", Vector3.new(1.4, 1.4, 1.4), Vector3.new(x, 1.5, -56), Color3.fromRGB(255, 80, 60))) end
	deco(a.box("BuoyRope", Vector3.new(104, 0.12, 0.12), Vector3.new(0, 1.7, -56), Color3.new(1, 1, 1)))
	for _, sx in ipairs({ -52, 52 }) do
		a.box("Rock", Vector3.new(14, 9, 14), Vector3.new(sx, 4.5, -38), Color3.fromRGB(120, 118, 112))
		a.box("Rock", Vector3.new(9, 7, 9), Vector3.new(sx, 12, -38), Color3.fromRGB(105, 110, 100))
		a.box("RockGreen", Vector3.new(6, 2, 6), Vector3.new(sx, 16.5, -38), Color3.fromRGB(70, 150, 70))
	end
	-- jet ski na agua rasa
	a.box("JetSki", Vector3.new(5, 1.2, 2), Vector3.new(36, 0.9, -30), Color3.fromRGB(250, 205, 40), PLASTIC, 0, 0.4)
	a.box("JetSkiSeat", Vector3.new(2, 0.6, 1.2), Vector3.new(36, 1.8, -30), Color3.fromRGB(30, 30, 35), PLASTIC, 0, 0.4)

	-- calcadao de Copacabana (ondas preto e branco)
	for r = 0, 3 do
		for ix = -10, 9 do
			local wz = 23.5 + r * 3 + math.sin(ix * 0.6 + r) * 0.8
			a.box("Calcadao", Vector3.new(6, 0.3, 3), Vector3.new(ix * 6 + 3, 0.15 + r * 0.01, wz), ((ix + r) % 2 == 0) and Color3.new(1, 1, 1) or Color3.fromRGB(30, 30, 35))
		end
	end
	a.box("Sidewalk", Vector3.new(SIZE, 0.3, 4), Vector3.new(0, 0.15, 36), Color3.fromRGB(215, 205, 190))
	a.box("Road", Vector3.new(SIZE, 0.2, 10), Vector3.new(0, 0.1, 43), Color3.fromRGB(60, 62, 70))
	for x = -54, 54, 12 do deco(a.box("RoadLine", Vector3.new(6, 0.1, 0.5), Vector3.new(x, 0.25, 43), Color3.new(1, 1, 1))) end
	for _, c in ipairs({ { -20, 45, Color3.fromRGB(240, 200, 40) }, { 24, 41, Color3.fromRGB(220, 60, 60) }, { -42, 41, Color3.fromRGB(70, 130, 220) } }) do
		a.box("Car", Vector3.new(9, 2.2, 4), Vector3.new(c[1], 1.3, c[2]), c[3])
		deco(a.box("CarTop", Vector3.new(5, 1.2, 3.6), Vector3.new(c[1], 3, c[2]), Color3.fromRGB(170, 215, 245)))
	end
	for x = -54, 54, 18 do
		palm(a, x, 35, 13)
		a.box("StreetLamp", Vector3.new(0.5, 9, 0.5), Vector3.new(x + 9, 4.5, 36.5), Color3.fromRGB(90, 90, 100))
		deco(a.box("LampTop", Vector3.new(1.6, 0.8, 1.6), Vector3.new(x + 9, 9.4, 36.5), Color3.fromRGB(255, 240, 150), Enum.Material.Neon))
	end

	-- predios da Avenida Atlantica (e o Copacabana Palace no meio)
	local brng = Random.new(21)
	local function hotel(x, w, h, col, name)
		a.box("Hotel", Vector3.new(w, h, 10), Vector3.new(x, h / 2, 55), col)
		a.box("HotelRoof", Vector3.new(w + 1, 1, 11), Vector3.new(x, h + 0.5, 55), Color3.fromRGB(200, 200, 205))
		for r = 1, math.floor((h - 4) / 6) do
			for c = 0, math.max(1, math.floor(w / 5)) - 1 do
				local lit = brng:NextNumber() < 0.4
				local wx = x - w / 2 + 2.5 + c * 5
				deco(a.box("Window", Vector3.new(2.6, 3, 0.3), Vector3.new(wx, r * 6, 49.85), lit and Color3.fromRGB(255, 235, 150) or Color3.fromRGB(150, 200, 235), lit and Enum.Material.Neon or PLASTIC))
				deco(a.box("Balcony", Vector3.new(3.4, 0.4, 1.4), Vector3.new(wx, r * 6 - 1.6, 49.4), Color3.fromRGB(235, 235, 235)))
			end
		end
		if name then sign(a.box("HotelSign", Vector3.new(w - 4, 3, 0.6), Vector3.new(x, h - 3, 49.6), Color3.fromRGB(150, 25, 40)), name, 0, 420, 90) end
	end
	hotel(-56, 8, 22, Color3.fromRGB(235, 200, 170), nil)
	hotel(-42, 18, 34, Color3.fromRGB(245, 235, 215), nil)
	hotel(-24, 18, 26, Color3.fromRGB(215, 230, 240), nil)
	hotel(0, 30, 30, Color3.fromRGB(250, 245, 235), "COPACABANA PALACE")
	hotel(24, 18, 38, Color3.fromRGB(240, 215, 200), nil)
	hotel(42, 18, 28, Color3.fromRGB(225, 235, 215), nil)
	hotel(56, 8, 24, Color3.fromRGB(245, 225, 190), nil)

	-- postos de guarda-vidas
	local function posto(x, z, label)
		for _, dx in ipairs({ -2, 2 }) do
			for _, dz in ipairs({ -2, 2 }) do a.box("PostoLeg", Vector3.new(0.7, 6, 0.7), Vector3.new(x + dx, 3, z + dz), Color3.fromRGB(240, 240, 240)) end
		end
		a.box("PostoDeck", Vector3.new(6, 0.6, 6), Vector3.new(x, 6.3, z), Color3.new(1, 1, 1))
		a.box("PostoCabin", Vector3.new(5, 4, 5), Vector3.new(x, 8.6, z), Color3.new(1, 1, 1))
		a.box("PostoStripe", Vector3.new(5.2, 1, 5.2), Vector3.new(x, 7.6, z), Color3.fromRGB(225, 40, 40))
		deco(a.box("PostoWindow", Vector3.new(3.5, 1.8, 0.3), Vector3.new(x, 9.2, z - 2.55), Color3.fromRGB(150, 210, 245)))
		local roof = a.box("PostoRoof", Vector3.new(7, 0.6, 7), Vector3.new(x, 10.9, z), Color3.fromRGB(225, 40, 40))
		sign(roof, label, 3, 220, 50)
		for i = 1, 5 do
			a.box("PostoStep", Vector3.new(3.2, 0.6, 1.4), Vector3.new(x, i * 1.15 - 0.3, z + 3 + 0.7 + (5 - i) * 1.4), Color3.fromRGB(235, 235, 235))
		end
		deco(a.box("Buoy", Vector3.new(4, 0.9, 1.2), Vector3.new(x + 5, 0.5, z - 1), Color3.fromRGB(235, 50, 40)))
		a.box("FlagPole", Vector3.new(0.3, 8, 0.3), Vector3.new(x - 5, 4, z + 3), Color3.fromRGB(220, 220, 225))
		deco(a.box("Flag", Vector3.new(2.6, 1.6, 0.2), Vector3.new(x - 6.4, 7.2, z + 3), Color3.fromRGB(225, 40, 40)))
	end
	posto(-28, -3, "POSTO 5 - GUARDA-VIDAS")
	posto(28, 3, "POSTO 6 - GUARDA-VIDAS")
	for _, fx in ipairs({ -15, 15 }) do
		a.box("FlagPole", Vector3.new(0.3, 7, 0.3), Vector3.new(fx, 3.5, -17), Color3.fromRGB(220, 220, 225))
		deco(a.box("Flag", Vector3.new(2.4, 1.5, 0.2), Vector3.new(fx + 1.3, 6.2, -17), (fx < 0) and Color3.fromRGB(250, 205, 40) or Color3.fromRGB(225, 40, 40)))
	end

	-- guarda-sois e cadeiras
	local PAL = { Color3.fromRGB(230, 50, 50), Color3.fromRGB(50, 110, 220), Color3.fromRGB(250, 200, 50), Color3.fromRGB(40, 170, 90), Color3.fromRGB(240, 130, 40) }
	local function sol(x, z, c1)
		a.box("UmbrellaPole", Vector3.new(0.3, 6, 0.3), Vector3.new(x, 3, z), Color3.fromRGB(200, 200, 205))
		a.box("Umbrella", Vector3.new(7, 0.5, 7), Vector3.new(x, 6.2, z), c1)
		a.box("Umbrella", Vector3.new(4.6, 0.5, 4.6), Vector3.new(x, 6.7, z), Color3.new(1, 1, 1))
		a.box("Umbrella", Vector3.new(2, 0.5, 2), Vector3.new(x, 7.15, z), c1)
		deco(a.box("Towel", Vector3.new(3, 0.1, 6), Vector3.new(x + 2.5, 0.06, z + 1), c1))
		a.box("ChairSeat", Vector3.new(2, 0.5, 2.4), Vector3.new(x - 2.5, 1.2, z + 1), Color3.fromRGB(240, 240, 240))
		a.box("ChairBack", Vector3.new(2, 2.2, 0.4), Vector3.new(x - 2.5, 2.2, z + 2.4), Color3.fromRGB(240, 240, 240))
	end
	for i, p in ipairs({ { -45, -8 }, { -38, 6 }, { -15, -10 }, { -8, 6 }, { 12, -9 }, { 20, 8 }, { 40, -6 }, { 46, 8 }, { -20, 8 }, { 34, -12 } }) do
		sol(p[1], p[2], PAL[(i - 1) % 5 + 1])
	end

	-- quadra de futevolei
	for _, z in ipairs({ -12.5, -3.5 }) do deco(a.box("CourtLine", Vector3.new(18, 0.1, 0.4), Vector3.new(0, 0.08, z), Color3.new(1, 1, 1))) end
	for _, x in ipairs({ -9, 9 }) do
		deco(a.box("CourtLine", Vector3.new(0.4, 0.1, 9), Vector3.new(x, 0.08, -8), Color3.new(1, 1, 1)))
		a.box("NetPost", Vector3.new(0.5, 6.4, 0.5), Vector3.new(x, 3.2, -8), Color3.fromRGB(220, 220, 225))
	end
	deco(a.box("Net", Vector3.new(18, 2.2, 0.15), Vector3.new(0, 5.2, -8), Color3.new(1, 1, 1), PLASTIC, 0.4))
	deco(a.box("NetTop", Vector3.new(18, 0.3, 0.25), Vector3.new(0, 6.4, -8), Color3.new(1, 1, 1)))
	a.box("Ball", Vector3.new(1.2, 1.2, 1.2), Vector3.new(3, 0.6, -6), Color3.fromRGB(250, 250, 250))

	-- pranchas de surf espetadas na areia
	for i, p in ipairs({ { -22, -16 }, { -20, -16 }, { 22, -16 }, { 24.5, -16 } }) do
		a.box("Surfboard", Vector3.new(1.4, 6, 0.3), Vector3.new(p[1], 3, p[2]), PAL[i + 1], PLASTIC, 0, 0.3 * i)
	end

	-- castelo de areia
	local sc = Color3.fromRGB(225, 195, 130)
	a.box("Castle", Vector3.new(8, 2, 8), Vector3.new(0, 1, 10), sc)
	for _, c in ipairs({ { -3, -3 }, { 3, -3 }, { -3, 3 }, { 3, 3 } }) do a.box("Tower", Vector3.new(2.4, 5, 2.4), Vector3.new(c[1], 2.5, 10 + c[2]), sc) end
	a.box("Keep", Vector3.new(4, 3.5, 4), Vector3.new(0, 3.75, 10), sc)
	deco(a.box("CastleFlag", Vector3.new(1.4, 0.9, 0.15), Vector3.new(0.9, 6.2, 10), Color3.fromRGB(0, 156, 59)))

	-- quiosque do coco
	a.box("KioskCounter", Vector3.new(9, 3.5, 3), Vector3.new(-50, 1.75, 11), Color3.fromRGB(150, 100, 60))
	for _, dx in ipairs({ -4.5, 4.5 }) do a.box("KioskPost", Vector3.new(0.8, 9, 0.8), Vector3.new(-50 + dx, 4.5, 8.5), Color3.fromRGB(110, 75, 40)) end
	for i = 0, 3 do a.box("KioskRoof", Vector3.new(2.7, 0.6, 7), Vector3.new(-54 + i * 2.7 + 1.35, 9.3, 10), (i % 2 == 0) and Color3.fromRGB(0, 156, 59) or Color3.fromRGB(254, 223, 0)) end
	sign(a.box("KioskSign", Vector3.new(8, 2.2, 0.5), Vector3.new(-50, 7.6, 8.4), Color3.fromRGB(255, 244, 214)), "QUIOSQUE DO COCO", 0, 300, 70)
	for i = -1, 1 do deco(a.box("Coconut", Vector3.new(1.2, 1.2, 1.2), Vector3.new(-50 + i * 2.2, 4.1, 11), Color3.fromRGB(70, 170, 70))) end

	for x = -50, 50, 10 do a.Spawns[#a.Spawns + 1] = a.Center + Vector3.new(x, 4, 16) end
	for x = -45, 45, 15 do a.Spawns[#a.Spawns + 1] = a.Center + Vector3.new(x, 4, -14) end
end

-- 9) PARQUE DE DIVERSOES: entrada, roda-gigante FUNCIONAL (motor + cabines na vertical), barracas, bancos, postes, cercas
do
	local a = newArena("Parque de Diversoes", Vector3.new(600, 0, 300), 17.6)
	parkArena = a
	local snowGround, snowCaps, centerDecor = {}, {}, {}
	a.SnowGround, a.SnowCaps, a.CenterDecor = snowGround, snowCaps, centerDecor
	local function ground(p) snowGround[#snowGround + 1] = p return p end
	local function cap(p) snowCaps[#snowCaps + 1] = p return p end
	local function capAt(cf, size) snowCaps[#snowCaps + 1] = { CF = cf, Size = size } end
	local function center(p) centerDecor[#centerDecor + 1] = p return p end
	local function bulb(p) p.CanCollide, p.CanTouch, p.CanQuery = false, false, false CS:AddTag(p, "PBBulb") return p end

	-- gramado listrado (12 faixas) + muros
	for i = 0, 11 do
		ground(a.box("Grass", Vector3.new(10, 2, SIZE), Vector3.new(-55 + i * 10, -1, 0), (i % 2 == 0) and Color3.fromRGB(96, 190, 72) or Color3.fromRGB(84, 174, 62)))
	end
	walls(a)

	-- caminhos coloridos
	local th = 0
	local function tile(x, z, s)
		th = th + 1
		ground(a.box("Tile", Vector3.new(s, 0.3, s), Vector3.new(x, 0.15, z), Color3.fromHSV((th * 0.137) % 1, 0.45, 1)))
	end
	for r = 0, 5 do
		for c = 0, 1 do
			tile(-3 + c * 6, 17 + r * 6, 6)
			tile(-3 + c * 6, -17 - r * 6, 6)
		end
	end
	for i = 0, 3 do for j = 0, 3 do tile(-10.5 + i * 7, -10.5 + j * 7, 7) end end
	for i = 0, 5 do
		for _, sx in ipairs({ -1, 1 }) do
			for _, zz in ipairs({ -3, 3 }) do tile(sx * (17 + i * 6), zz, 6) end
		end
	end

	-- entrada grande
	for _, x in ipairs({ -15, 15 }) do
		a.box("GateTower", Vector3.new(7, 18, 7), Vector3.new(x, 9, 57), Color3.fromRGB(235, 70, 70))
		for k = 0, 2 do
			a.box("GateStripe", Vector3.new(7.4, 2, 7.4), Vector3.new(x, 4 + k * 5, 57), (k % 2 == 0) and Color3.new(1, 1, 1) or Color3.fromRGB(250, 205, 50))
		end
		cap(a.box("GateTop", Vector3.new(9, 1.2, 9), Vector3.new(x, 18.6, 57), Color3.fromRGB(80, 120, 230)))
		a.box("GateSpire", Vector3.new(2, 5, 2), Vector3.new(x, 22, 57), Color3.fromRGB(250, 205, 50))
		bulb(a.box("GateLight", Vector3.new(1.4, 1.4, 1.4), Vector3.new(x, 25.2, 57), Color3.fromRGB(255, 240, 120), Enum.Material.Neon))
	end
	cap(a.box("GateBeam", Vector3.new(34, 3, 5), Vector3.new(0, 19, 57), Color3.fromRGB(250, 205, 50)))
	local gs = a.box("GateSign", Vector3.new(30, 7, 1.2), Vector3.new(0, 25, 57), Color3.fromRGB(235, 70, 70))
	plaque(gs, "PARQUE DE DIVERSÕES", { Enum.NormalId.Front, Enum.NormalId.Back }, 1000, 230)
	capAt(gs.CFrame * CFrame.new(0, 3.75, 0), Vector3.new(30.2, 0.5, 1.4))
	for i = -6, 6 do
		deco(a.box("Bunting", Vector3.new(1.4, 1.6, 0.2), Vector3.new(i * 2.4, 16.8, 54.3), Color3.fromHSV(((i + 6) * 0.11) % 1, 0.8, 1)))
	end
	for _, x in ipairs({ -6, -2, 2, 6 }) do
		a.box("TurnstilePost", Vector3.new(0.8, 4, 0.8), Vector3.new(x, 2, 53), Color3.fromRGB(60, 60, 80))
		deco(a.box("TurnstileBar", Vector3.new(2.6, 0.3, 0.3), Vector3.new(x, 3.4, 53), Color3.fromRGB(250, 205, 50)))
	end
	for _, x in ipairs({ -24, 24 }) do
		a.box("TicketBooth", Vector3.new(6, 5, 5), Vector3.new(x, 2.5, 52), Color3.fromRGB(80, 150, 230))
		deco(a.box("BoothWindow", Vector3.new(3.6, 2, 0.3), Vector3.new(x, 3, 49.4), Color3.fromRGB(180, 225, 250)))
		cap(a.box("BoothRoof", Vector3.new(7.4, 0.8, 6.4), Vector3.new(x, 5.4, 52), Color3.fromRGB(235, 70, 70)))
		sign(a.box("BoothSign", Vector3.new(4, 1.2, 0.3), Vector3.new(x, 6.6, 49.4), Color3.fromRGB(255, 244, 214)), "BILHETES", 0, 200, 50)
	end

	-- fonte central (sai no Natal para dar lugar a arvore gigante)
	center(a.box("FountainBasin", Vector3.new(12, 1.2, 12), Vector3.new(0, 0.6, 0), Color3.fromRGB(160, 165, 180)))
	center(deco(a.box("FountainWater", Vector3.new(10, 0.4, 10), Vector3.new(0, 1.3, 0), Color3.fromRGB(90, 190, 255), PLASTIC, 0.3)))
	center(a.box("FountainColumn", Vector3.new(3, 5, 3), Vector3.new(0, 3.5, 0), Color3.fromRGB(235, 235, 245)))
	center(a.box("FountainTop", Vector3.new(5, 0.8, 5), Vector3.new(0, 6.4, 0), Color3.fromRGB(250, 205, 50)))

	-- bancos
	local function bench(x, z, yaw)
		local base = CFrame.new(a.Center + Vector3.new(x, 0, z)) * CFrame.Angles(0, yaw, 0)
		local function bp(nm, sz, off, col) return P(a.Folder, nm, sz, base * CFrame.new(off), col) end
		cap(bp("BenchSeat", Vector3.new(4.4, 0.5, 1.6), Vector3.new(0, 1.4, 0), Color3.fromRGB(190, 120, 60)))
		bp("BenchBack", Vector3.new(4.4, 1.4, 0.4), Vector3.new(0, 2.5, -0.7), Color3.fromRGB(170, 105, 50))
		for _, dx in ipairs({ -1.8, 1.8 }) do bp("BenchLeg", Vector3.new(0.4, 1.2, 1.4), Vector3.new(dx, 0.6, 0), Color3.fromRGB(60, 60, 70)) end
	end
	for _, b in ipairs({ { 0, 12.5, math.pi }, { 0, -12.5, 0 }, { 12.5, 0, -math.pi / 2 }, { -12.5, 0, math.pi / 2 },
		{ 9, 24, -math.pi / 2 }, { 9, 36, -math.pi / 2 }, { -9, 24, math.pi / 2 }, { -9, 36, math.pi / 2 },
		{ 9, -24, -math.pi / 2 }, { 9, -36, -math.pi / 2 }, { -9, -24, math.pi / 2 }, { -9, -36, math.pi / 2 },
		{ 26, 8, math.pi }, { 26, -8, 0 }, { 40, 8, math.pi }, { 40, -8, 0 } }) do
		bench(b[1], b[2], b[3])
	end

	-- postes de luz (so alguns com luz de verdade para rodar bem no celular)
	local function lamp(x, z, lit)
		a.box("LampBase", Vector3.new(1.6, 1, 1.6), Vector3.new(x, 0.5, z), Color3.fromRGB(60, 60, 80))
		a.box("LampPole", Vector3.new(0.7, 11, 0.7), Vector3.new(x, 5.5, z), Color3.fromRGB(60, 60, 80))
		local head = bulb(a.box("LampHead", Vector3.new(2, 1, 2), Vector3.new(x, 11.5, z), Color3.fromRGB(255, 235, 150), Enum.Material.Neon))
		CS:RemoveTag(head, "PBBulb")
		if lit then
			local l = Instance.new("PointLight")
			l.Range, l.Brightness, l.Color, l.Shadows = 22, 1.2, Color3.fromRGB(255, 220, 150), false
			l.Parent = head
		end
	end
	for _, z in ipairs({ 44, 32, 20, -20, -32, -44 }) do
		lamp(-8, z, z == 44)
		lamp(8, z, z == 44)
	end
	for _, c in ipairs({ { -15.5, -15.5 }, { 15.5, -15.5 }, { -15.5, 15.5 }, { 15.5, 15.5 } }) do lamp(c[1], c[2], true) end

	-- cercas baixas
	local function fence(x0, z0, x1, z1)
		local dx, dz = x1 - x0, z1 - z0
		local len = math.sqrt(dx * dx + dz * dz)
		local yaw = math.atan2(dx, dz)
		for _, y in ipairs({ 0.8, 1.4 }) do
			a.box("FenceRail", Vector3.new(0.3, 0.3, len), Vector3.new((x0 + x1) / 2, y, (z0 + z1) / 2), Color3.new(1, 1, 1), PLASTIC, 0, yaw)
		end
		local n = math.max(1, math.floor(len / 4))
		for i = 0, n do
			a.box("FencePost", Vector3.new(0.5, 1.8, 0.5), Vector3.new(x0 + dx * i / n, 0.9, z0 + dz * i / n), Color3.fromRGB(250, 205, 50))
		end
	end
	for _, f in ipairs({ { 17, 58, 55, 58 }, { -17, 58, -55, 58 }, { 24, -18, 56, -18 }, { 24, -18, 24, -50 } }) do fence(f[1], f[2], f[3], f[4]) end

	-- canteiros de flores
	local function flowerbed(x, z)
		cap(a.box("BedBase", Vector3.new(6, 1, 4), Vector3.new(x, 0.5, z), Color3.fromRGB(120, 80, 45)))
		for i = -2, 2 do
			deco(a.box("Flower", Vector3.new(0.9, 0.9, 0.9), Vector3.new(x + i * 1.1, 1.4, z + ((i % 2 == 0) and 0.8 or -0.8)), Color3.fromHSV(((i + 3) * 0.17) % 1, 0.7, 1)))
		end
		fence(x - 3.6, z - 2.6, x + 3.6, z - 2.6)
		fence(x - 3.6, z + 2.6, x + 3.6, z + 2.6)
	end
	for _, b in ipairs({ { 12, 30 }, { -12, 30 }, { 12, -30 }, { -12, -30 } }) do flowerbed(b[1], b[2]) end

	-- barracas de comida e jogos
	local function stand(x, z, yaw, name, c1, c2, props)
		local base = CFrame.new(a.Center + Vector3.new(x, 0, z)) * CFrame.Angles(0, yaw, 0)
		local function sp(nm, sz, off, col, mat) return P(a.Folder, nm, sz, base * CFrame.new(off), col, mat) end
		sp("Counter", Vector3.new(9, 3.5, 3), Vector3.new(0, 1.75, 0), Color3.fromRGB(150, 100, 60))
		sp("CounterTop", Vector3.new(9.6, 0.5, 3.6), Vector3.new(0, 3.75, 0.2), c2)
		sp("BackWall", Vector3.new(9, 7.5, 0.6), Vector3.new(0, 3.75, -1.6), c1)
		for _, dx in ipairs({ -4.4, 4.4 }) do sp("Post", Vector3.new(0.7, 8, 0.7), Vector3.new(dx, 4, 1.5), Color3.fromRGB(110, 75, 40)) end
		sp("AwningBase", Vector3.new(9.8, 0.4, 6), Vector3.new(0, 8.2, 0), c1)
		for i = 0, 4 do sp("AwningStripe", Vector3.new(1.96, 0.3, 6), Vector3.new(-3.92 + i * 1.96, 8.55, 0), (i % 2 == 0) and c2 or Color3.new(1, 1, 1)) end
		capAt(base * CFrame.new(0, 8.95, 0), Vector3.new(10, 0.5, 6.2))
		local board = sp("StandSign", Vector3.new(8, 2.2, 0.5), Vector3.new(0, 10, -1.2), Color3.fromRGB(60, 40, 30))
		plaque(board, name, { Enum.NormalId.Back, Enum.NormalId.Front }, 700, 200)
		props(sp)
	end
	local YEL, GRN, BRN, RED, WHT = Color3.fromRGB(245, 200, 70), Color3.fromRGB(80, 190, 70), Color3.fromRGB(120, 70, 40), Color3.fromRGB(225, 50, 40), Color3.new(1, 1, 1)
	stand(22, 38, -math.pi / 2, "TACOS", Color3.fromRGB(240, 140, 40), Color3.fromRGB(250, 210, 60), function(sp)
		for i = -1, 1 do
			sp("Taco", Vector3.new(1.8, 0.9, 1.2), Vector3.new(i * 2.6, 4.5, 0.3), YEL)
			sp("TacoTop", Vector3.new(1.7, 0.3, 1.0), Vector3.new(i * 2.6, 5.1, 0.3), GRN)
		end
	end)
	stand(22, 22, -math.pi / 2, "HAMBURGUERES", RED, WHT, function(sp)
		for _, x in ipairs({ -2, 2 }) do
			sp("BunB", Vector3.new(1.6, 0.4, 1.6), Vector3.new(x, 4.2, 0.3), Color3.fromRGB(215, 150, 70))
			sp("Patty", Vector3.new(1.7, 0.35, 1.7), Vector3.new(x, 4.58, 0.3), BRN)
			sp("Lettuce", Vector3.new(1.8, 0.2, 1.8), Vector3.new(x, 4.85, 0.3), GRN)
			sp("BunT", Vector3.new(1.6, 0.7, 1.6), Vector3.new(x, 5.3, 0.3), Color3.fromRGB(225, 160, 80))
		end
	end)
	stand(-22, 38, math.pi / 2, "SORVETE", Color3.fromRGB(240, 130, 180), WHT, function(sp)
		for i = -1, 1 do
			sp("Cone", Vector3.new(0.9, 1.4, 0.9), Vector3.new(i * 2.6, 4.7, 0.3), Color3.fromRGB(215, 170, 100))
			sp("Scoop", Vector3.new(1.2, 1.1, 1.2), Vector3.new(i * 2.6, 5.9, 0.3), Color3.fromHSV((i + 2) * 0.2, 0.4, 1))
		end
	end)
	stand(-22, 22, math.pi / 2, "PIPOCA", Color3.fromRGB(250, 200, 40), RED, function(sp)
		for i = -1, 1 do
			sp("Bucket", Vector3.new(1.4, 1.8, 1.4), Vector3.new(i * 2.6, 4.9, 0.3), (i % 2 == 0) and RED or WHT)
			sp("Popcorn", Vector3.new(1.6, 0.8, 1.6), Vector3.new(i * 2.6, 6.2, 0.3), Color3.fromRGB(255, 245, 200))
		end
	end)
	stand(44, 6, -math.pi / 2, "JOGOS", Color3.fromRGB(130, 90, 220), Color3.fromRGB(80, 170, 240), function(sp)
		for i = -2, 2 do sp("Plush", Vector3.new(1.4, 1.4, 1.4), Vector3.new(i * 1.8, 5.5, -1.0), Color3.fromHSV((i + 3) * 0.15, 0.6, 1)) end
	end)

	-- arvores, sebes, baloes
	for i, t in ipairs({ { -54, -50 }, { -54, -30 }, { -54, 30 }, { -54, 50 }, { 54, -50 }, { 54, -30 }, { 54, 30 }, { 54, 50 }, { -30, -56 }, { 30, -56 }, { 0, -57 }, { 54, 10 } }) do
		cap(tree(a, t[1], t[2], 8, Color3.fromRGB(46, 150, 60)))
	end
	for _, x in ipairs({ -30, 30 }) do cap(a.box("Hedge", Vector3.new(14, 3, 2.4), Vector3.new(x, 1.5, 52), Color3.fromRGB(40, 140, 55))) end
	for _, c in ipairs({ { -10, 52 }, { 10, 52 }, { 18, -18 }, { -18, -18 } }) do
		deco(a.box("BalloonString", Vector3.new(0.1, 8, 0.1), Vector3.new(c[1], 4, c[2]), Color3.new(1, 1, 1)))
		for k = 0, 4 do
			local ang = k * math.pi * 2 / 5
			deco(a.box("Balloon", Vector3.new(1.6, 2, 1.6), Vector3.new(c[1] + math.cos(ang) * 1.3, 9.6 + (k % 2) * 0.8, c[2] + math.sin(ang) * 1.3), Color3.fromHSV((k * 0.2 + c[1] * 0.01) % 1, 0.8, 1)))
		end
	end

	-- tenda de circo (escalavel)
	for i, t in ipairs({ { 22, 6 }, { 16, 5 }, { 10, 5 }, { 5, 4 } }) do
		local y = 0
		for k = 1, i - 1 do y = y + ({ 6, 5, 5, 4 })[k] end
		cap(a.box("Tent", Vector3.new(t[1], t[2], t[1]), Vector3.new(40, y + t[2] / 2, -32), (i % 2 == 1) and RED or WHT))
	end
	a.box("TentPole", Vector3.new(0.4, 5, 0.4), Vector3.new(40, 22.5, -32), Color3.fromRGB(200, 200, 205))
	deco(a.box("TentFlag", Vector3.new(2.6, 1.6, 0.2), Vector3.new(41.4, 24, -32), Color3.fromRGB(250, 205, 50)))

	-- ===== RODA-GIGANTE (fisica real) =====
	local HUBREL = Vector3.new(-38, 37, -10)
	local HUB = a.Center + HUBREL
	local R, NC = 28, 10
	local hub, wheelParts = nil, {}
	local function wp(nm, size, cf, color, collide, mat)
		local p = P(a.Folder, nm, size, cf, color, mat)
		p.Anchored = false
		p.CanCollide = collide
		if not collide then p.CanTouch, p.CanQuery = false, false end
		wheelParts[#wheelParts + 1] = p
		return p
	end
	local axle = P(a.Folder, "Axle", Vector3.new(15, 2, 2), CFrame.new(HUB), Color3.fromRGB(90, 90, 105))
	axle.CanCollide = false
	hub = wp("Hub", Vector3.new(11, 3, 3), CFrame.new(HUB), Color3.fromRGB(240, 240, 245), false)
	local hl = Instance.new("PointLight")
	hl.Range, hl.Brightness, hl.Color, hl.Shadows = 60, 1, Color3.fromRGB(255, 210, 140), false
	hl.Parent = hub
	for i = 0, 19 do
		local ang = i / 20 * math.pi * 2
		for _, sx in ipairs({ -3.5, 3.5 }) do
			local rim = wp("Rim", Vector3.new(1.2, 1.2, 9), CFrame.new(HUB + Vector3.new(sx, 0, 0)) * CFrame.Angles(ang, 0, 0) * CFrame.new(0, R, 0), (i % 2 == 0) and Color3.fromRGB(235, 70, 70) or Color3.fromRGB(250, 205, 50), false)
			weld(hub, rim)
			local b = wp("RimBulb", Vector3.new(0.9, 0.9, 0.9), CFrame.new(HUB + Vector3.new(sx * 1.17, 0, 0)) * CFrame.Angles(ang, 0, 0) * CFrame.new(0, R + 0.1, 0), Color3.fromRGB(255, 240, 120), false, Enum.Material.Neon)
			bulb(b)
			weld(hub, b)
		end
	end
	for i = 0, 9 do
		local ang = i / 10 * math.pi * 2
		for _, sx in ipairs({ -3.5, 3.5 }) do
			local sk = wp("Spoke", Vector3.new(0.8, R, 0.8), CFrame.new(HUB + Vector3.new(sx, 0, 0)) * CFrame.Angles(ang, 0, 0) * CFrame.new(0, R / 2, 0), Color3.new(1, 1, 1), false)
			weld(hub, sk)
		end
	end
	for i = 0, NC - 1 do
		local ang = i / NC * math.pi * 2
		local barCF = CFrame.new(HUB) * CFrame.Angles(ang, 0, 0) * CFrame.new(0, R, 0)
		local bar = wp("Bar", Vector3.new(7.8, 1, 1), barCF, Color3.fromRGB(235, 235, 240), false)
		weld(hub, bar)
		local rc = CFrame.new(barCF.Position + Vector3.new(0, -2.65, 0))
		local col = Color3.fromHSV(i / NC, 0.75, 1)
		local function cp(nm, sz, off, c, collide) return wp(nm, sz, rc * CFrame.new(off), c, collide) end
		local roof = cp("CabinRoof", Vector3.new(6, 0.5, 6), Vector3.new(0, 0, 0), col, true)
		local parts = {
			cp("CabinFloor", Vector3.new(5.6, 0.5, 5.6), Vector3.new(0, -4.5, 0), Color3.fromRGB(80, 80, 95), true),
			cp("Hanger", Vector3.new(0.4, 2.4, 0.4), Vector3.new(0, 1.45, 0), Color3.fromRGB(235, 235, 240), false),
			cp("RailX", Vector3.new(0.4, 1.4, 5.6), Vector3.new(2.8, -3.55, 0), col, true),
			cp("RailX", Vector3.new(0.4, 1.4, 5.6), Vector3.new(-2.8, -3.55, 0), col, true),
			cp("RailZ", Vector3.new(5.6, 1.4, 0.4), Vector3.new(0, -3.55, 2.8), col, true),
			cp("RailZ", Vector3.new(5.6, 1.4, 0.4), Vector3.new(0, -3.55, -2.8), col, true),
		}
		for _, c in ipairs({ { 2.75, 2.75 }, { -2.75, 2.75 }, { 2.75, -2.75 }, { -2.75, -2.75 } }) do
			parts[#parts + 1] = cp("CabinPost", Vector3.new(0.5, 4, 0.5), Vector3.new(c[1], -2.25, c[2]), Color3.fromRGB(235, 235, 240), false)
		end
		local lightBulb = cp("CabinBulb", Vector3.new(1, 1, 1), Vector3.new(0, 0.9, 0), Color3.fromRGB(255, 240, 120), false)
		lightBulb.Material = Enum.Material.Neon
		bulb(lightBulb)
		parts[#parts + 1] = lightBulb
		for _, p in ipairs(parts) do weld(roof, p) end
		-- articulacao: o cabo gira livre na barra, e a cabine e mantida SEMPRE na vertical
		local a0 = Instance.new("Attachment")
		a0.Parent = bar
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(0, 1.2, 0)
		a1.Parent = parts[2]
		local bs = Instance.new("BallSocketConstraint")
		bs.Attachment0, bs.Attachment1, bs.Parent = a0, a1, bar
		local a2 = Instance.new("Attachment")
		a2.Parent = roof
		local ao = Instance.new("AlignOrientation")
		ao.Mode, ao.Attachment0, ao.CFrame, ao.RigidityEnabled = Enum.OrientationAlignmentMode.OneAttachment, a2, CFrame.new(), true
		ao.Parent = roof
		cap(roof)
	end
	-- motor
	local h0, h1 = Instance.new("Attachment"), Instance.new("Attachment")
	h0.Parent, h1.Parent = axle, hub
	local hinge = Instance.new("HingeConstraint")
	hinge.Attachment0, hinge.Attachment1 = h0, h1
	hinge.ActuatorType = Enum.ActuatorType.Motor
	hinge.AngularVelocity = 0.3
	hinge.MotorMaxTorque = 1e9
	hinge.Parent = axle
	pcall(function() hub:SetNetworkOwner(nil) end)
	for _, p in ipairs(wheelParts) do
		if p.Name == "CabinRoof" then pcall(function() p:SetNetworkOwner(nil) end) end
	end
	-- estrutura de apoio, plataforma e fila
	local legLen = math.sqrt(37 * 37 + 16 * 16)
	for _, sx in ipairs({ -5.5, 5.5 }) do
		for _, sz in ipairs({ -1, 1 }) do
			local c = a.Center + Vector3.new(HUBREL.X + sx, 18.5, HUBREL.Z + sz * 8)
			P(a.Folder, "WheelLeg", Vector3.new(1.6, legLen, 1.6), CFrame.new(c) * CFrame.Angles(math.atan2(-sz * 16, 37), 0, 0), Color3.fromRGB(235, 235, 245))
		end
	end
	a.box("WheelPlatform", Vector3.new(10, 0.3, 12), Vector3.new(HUBREL.X, 0.15, HUBREL.Z), Color3.fromRGB(250, 205, 50))
	local function lowrail(x0, z0, x1, z1)
		local dx, dz = x1 - x0, z1 - z0
		local len = math.sqrt(dx * dx + dz * dz)
		a.box("QueueRail", Vector3.new(0.3, 0.3, len), Vector3.new((x0 + x1) / 2, 1.1, (z0 + z1) / 2), Color3.new(1, 1, 1), PLASTIC, 0, math.atan2(dx, dz))
		for i = 0, math.max(1, math.floor(len / 4)) do
			a.box("QueuePost", Vector3.new(0.4, 1.3, 0.4), Vector3.new(x0 + dx * i / math.max(1, math.floor(len / 4)), 0.65, z0 + dz * i / math.max(1, math.floor(len / 4))), Color3.fromRGB(235, 70, 70))
		end
	end
	local wx, wz = HUBREL.X, HUBREL.Z
	lowrail(wx - 6.5, wz - 8, wx - 6.5, wz + 8)
	lowrail(wx + 6.5, wz - 8, wx + 6.5, wz - 2)
	lowrail(wx + 6.5, wz + 2, wx + 6.5, wz + 8)
	a.box("WheelSignPost", Vector3.new(0.6, 8, 0.6), Vector3.new(wx + 9, 4, wz - 9), Color3.fromRGB(235, 70, 70))
	sign(a.box("WheelSign", Vector3.new(7, 2, 0.5), Vector3.new(wx + 9, 9, wz - 9), Color3.fromRGB(60, 40, 30)), "RODA-GIGANTE", 0, 300, 60)

	for k = -40, 40, 10 do
		a.Spawns[#a.Spawns + 1] = a.Center + Vector3.new(k, 4, 46)
		a.Spawns[#a.Spawns + 1] = a.Center + Vector3.new(k, 4, -48)
	end
end

-- 7) DINO WORLD (EVENTO): selva, portao, cerca eletrica, rio com vagonetes e um T-Rex animado
do
	local a = newArena("Dino World (EVENTO)", Vector3.new(0, 0, -650), 15, true)
	dinoArena = a
	a.box("FloorS", Vector3.new(SIZE, 2, 50), Vector3.new(0, -1, 35), Color3.fromRGB(60, 120, 50))
	a.box("FloorN", Vector3.new(SIZE, 2, 50), Vector3.new(0, -1, -35), Color3.fromRGB(60, 120, 50))
	a.box("Riverbed", Vector3.new(SIZE, 2, 20), Vector3.new(0, -4.5, 0), Color3.fromRGB(150, 130, 90))
	walls(a)
	hazard(a.box("River", Vector3.new(SIZE, 2.8, 20), Vector3.new(0, -2.1, 0), Color3.fromRGB(60, 150, 190), PLASTIC, 0.3), " caiu no rio!")
	a.box("Ford", Vector3.new(12, 1, 20.4), Vector3.new(0, -0.5, 0), Color3.fromRGB(140, 135, 125))
	-- vagonetes do passeio (trilhos com servo)
	local cars = {}
	for _, x in ipairs({ -25, 25 }) do
		local track = P(a.Folder, "Track", Vector3.new(1, 1, 1), CFrame.new(a.Center + Vector3.new(x, 0.5, 0)), Color3.new(0, 0, 0), PLASTIC, 1)
		track.CanCollide = false
		local car = P(a.Folder, "RailCar", Vector3.new(8, 1, 8), CFrame.new(a.Center + Vector3.new(x, 0.5, 0)), Color3.fromRGB(235, 200, 60))
		car.Anchored = false
		car.CustomPhysicalProperties = PhysicalProperties.new(1, 2, 0, 1, 1)
		local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
		a0.CFrame, a1.CFrame = CFrame.Angles(0, math.pi / 2, 0), CFrame.Angles(0, math.pi / 2, 0)
		a0.Parent, a1.Parent = track, car
		local pc = Instance.new("PrismaticConstraint")
		pc.Attachment0, pc.Attachment1 = a0, a1
		pc.ActuatorType = Enum.ActuatorType.Servo
		pc.ServoMaxForce, pc.LinearResponsiveness, pc.Speed = 1e7, 40, 6
		pc.LimitsEnabled, pc.LowerLimit, pc.UpperLimit, pc.TargetPosition = true, -15, 15, 0
		pc.Parent = track
		cars[#cars + 1] = pc
		pcall(function() car:SetNetworkOwner(nil) end)
		for _, rx in ipairs({ -2.5, 2.5 }) do deco(a.box("Rail", Vector3.new(0.5, 0.3, 36), Vector3.new(x + rx, 0, 0), Color3.fromRGB(120, 120, 130))) end
	end
	task.spawn(function()
		local dir = 1
		while true do
			if cars[1] then cars[1].TargetPosition = dir * 14 end
			if cars[2] then cars[2].TargetPosition = -dir * 14 end
			dir = -dir
			task.wait(5)
		end
	end)
	-- cercas eletricas
	local function fence(x0, x1, z)
		local len = x1 - x0
		local n = math.max(1, math.floor(len / 6))
		for i = 0, n do a.box("FencePost", Vector3.new(0.8, 10, 0.8), Vector3.new(x0 + i * (len / n), 5, z), Color3.fromRGB(180, 180, 190)) end
		for _, y in ipairs({ 3, 6, 9 }) do
			a.box("Wire", Vector3.new(len, 0.25, 0.25), Vector3.new((x0 + x1) / 2, y, z), Color3.fromRGB(255, 230, 60), Enum.Material.Neon)
		end
	end
	for _, z in ipairs({ -14, 14 }) do
		fence(-58, -31, z)
		fence(-19, -6, z)
		fence(6, 19, z)
		fence(31, 58, z)
	end
	sign(a.box("Warning", Vector3.new(5, 3, 0.4), Vector3.new(-9, 5, 14), Color3.fromRGB(255, 200, 40)), "CUIDADO: T-REX", 0, 260, 60)
	-- portao
	for _, x in ipairs({ -16, 16 }) do
		a.box("GatePillar", Vector3.new(8, 22, 8), Vector3.new(x, 11, 55), Color3.fromRGB(130, 120, 110))
		deco(a.box("Torch", Vector3.new(1.2, 2, 1.2), Vector3.new(x, 23, 55), Color3.fromRGB(255, 140, 40), Enum.Material.Neon))
	end
	a.box("GateBeam", Vector3.new(40, 4, 4), Vector3.new(0, 20, 55), Color3.fromRGB(110, 75, 40))
	sign(a.box("GateSign", Vector3.new(26, 5, 1), Vector3.new(0, 25, 55), Color3.fromRGB(230, 150, 30)), "DINO WORLD", 0, 520, 110)
	-- passarela, selva, montanha e cachoeira
	deco(a.box("Boardwalk", Vector3.new(8, 0.25, 36), Vector3.new(0, 0.12, 38), Color3.fromRGB(170, 120, 70)))
	deco(a.box("Boardwalk", Vector3.new(8, 0.25, 36), Vector3.new(0, 0.12, -38), Color3.fromRGB(170, 120, 70)))
	for i, t in ipairs({ { -52, -26 }, { -52, -48 }, { -52, 26 }, { -52, 48 }, { 52, -26 }, { 52, -48 }, { 52, 26 }, { 52, 48 }, { -30, -54 }, { 30, -54 }, { -30, 54 }, { 30, 54 } }) do
		if i % 3 == 0 then palm(a, t[1], t[2], 14) else tree(a, t[1], t[2], 9, Color3.fromRGB(30, 120, 50)) end
	end
	a.box("Mountain", Vector3.new(70, 10, 10), Vector3.new(0, 5, -55), Color3.fromRGB(110, 105, 100))
	a.box("Mountain", Vector3.new(50, 8, 8), Vector3.new(0, 14, -55), Color3.fromRGB(95, 90, 88))
	a.box("Mountain", Vector3.new(30, 8, 6), Vector3.new(0, 22, -55), Color3.fromRGB(85, 80, 78))
	deco(a.box("Waterfall", Vector3.new(5, 10, 0.8), Vector3.new(-18, 5, -49.6), Color3.fromRGB(150, 210, 255), PLASTIC, 0.35))
	for _, b in ipairs({ { -26, 0, -18 }, { 30, 0, 20 } }) do
		for k = -2, 2 do a.box("Rib", Vector3.new(0.7, 3.5, 0.7), Vector3.new(b[1] + k * 2.2, 1.75, b[3]), BONE) end
	end
	-- jipe
	local jb = CFrame.new(a.Center + Vector3.new(46, 0, 50)) * CFrame.Angles(0, 0.5, 0)
	local function jp(nm, sz, off, col)
		return P(a.Folder, nm, sz, jb * CFrame.new(off), col)
	end
	jp("JeepBody", Vector3.new(6, 2.5, 12), Vector3.new(0, 2.2, 0), Color3.fromRGB(215, 170, 90))
	jp("JeepHood", Vector3.new(5.6, 1.4, 3.5), Vector3.new(0, 3.2, -4.5), Color3.fromRGB(190, 60, 50))
	for _, sx in ipairs({ -3.2, 3.2 }) do
		for _, sz in ipairs({ -3.8, 3.8 }) do jp("Wheel", Vector3.new(1, 2.6, 2.6), Vector3.new(sx, 1.3, sz), Color3.fromRGB(30, 30, 35)) end
		for _, sz in ipairs({ -1, 3 }) do deco(jp("Roll", Vector3.new(0.4, 3, 0.4), Vector3.new(sx * 0.9, 4.7, sz), Color3.fromRGB(190, 190, 195))) end
	end
	deco(jp("RollTop", Vector3.new(6, 0.4, 4.4), Vector3.new(0, 6.3, 1), Color3.fromRGB(190, 190, 195)))

	-- T-REX com animacao procedural (andar, rabo, cabeca, mandibula, rugido)
	local V = Vector3.new
	local G, D, K, Wt = Color3.fromRGB(70, 140, 60), Color3.fromRGB(50, 105, 45), Color3.fromRGB(20, 20, 20), Color3.fromRGB(245, 240, 225)
	local trexM = Instance.new("Model")
	trexM.Name = "TRex"
	trexM.Parent = a.Folder
	local rig = {}
	local function tp(name, size, x, y, z, col, pvt, anim)
		local p = Instance.new("Part")
		p.Name, p.Size, p.Color, p.Material, p.Anchored, p.CanCollide = name, size, col, PLASTIC, true, false
		for _, f in ipairs(FACES) do p[f] = Enum.SurfaceType.Studs end
		p.Parent = trexM
		local rest = CFrame.new(x, y, z)
		rig[#rig + 1] = { p = p, rest = rest, pvt = pvt and CFrame.new(pvt) or rest, anim = anim }
	end
	tp("Body", V(6, 6.5, 12), 0, 10, 0, G)
	tp("Chest", V(5.5, 6.5, 5), 0, 11.2, -6.5, G)
	for i = -2, 2 do tp("Spike", V(0.6, 1, 1.4), 0, 13.8, i * 2.3, D) end
	tp("Neck", V(3.5, 4, 4), 0, 14.2, -8.5, G, V(0, 12, -7), "head")
	tp("Head", V(4, 3.6, 6), 0, 16.6, -11.5, G, V(0, 12, -7), "head")
	tp("Jaw", V(3.4, 1, 5.5), 0, 14.6, -11.2, D, V(0, 14.8, -8.6), "jaw")
	for i = -2, 2 do
		tp("Tooth", V(0.4, 0.7, 0.4), i * 0.7, 14.45, -14.2, Wt, V(0, 12, -7), "head")
		tp("Tooth", V(0.4, 0.7, 0.4), i * 0.7, 15.45, -13.7, Wt, V(0, 14.8, -8.6), "jaw")
	end
	for _, s in ipairs({ -1, 1 }) do
		tp("Eye", V(0.7, 0.7, 0.4), 2.05 * s, 17.4, -12.5, K, V(0, 12, -7), "head")
		tp("Arm", V(0.8, 2.2, 0.8), 2.9 * s, 11.2, -9, G, V(2.9 * s, 12.3, -9), "arm")
		local an = (s < 0) and "legL" or "legR"
		local hip = V(3.2 * s, 7.5, 1.5)
		tp("Thigh", V(2.8, 5, 3.4), 3.2 * s, 5, 1.5, G, hip, an)
		tp("Shin", V(1.8, 2.6, 2.2), 3.2 * s, 1.5, 1.2, D, hip, an)
		tp("Foot", V(2.8, 0.8, 5), 3.2 * s, 0.4, -0.2, D, hip, an)
	end
	tp("Tail1", V(4, 4, 6), 0, 9.5, 8.5, G, V(0, 9.5, 5.5), "tail1")
	tp("Tail2", V(3, 3, 6), 0, 9.2, 14, G, V(0, 9.2, 11), "tail2")
	tp("Tail3", V(1.8, 1.8, 5), 0, 9, 19, D, V(0, 9, 16.5), "tail3")

	local function pose(root, t)
		local rt = t % 10
		local roar = (rt > 8 and rt < 9.2) and math.sin((rt - 8) / 1.2 * math.pi) or 0
		local ph = t * 4.5
		local base = root * CFrame.new(0, math.abs(math.sin(ph)) * 0.35, 0)
		for _, r in ipairs(rig) do
			local rot, an = CFrame.new(), r.anim
			if an == "legL" then rot = CFrame.Angles(math.sin(ph) * 0.45, 0, 0)
			elseif an == "legR" then rot = CFrame.Angles(-math.sin(ph) * 0.45, 0, 0)
			elseif an == "head" then rot = CFrame.Angles(math.sin(t * 2) * 0.05 + roar * 0.35, 0, 0)
			elseif an == "jaw" then rot = CFrame.Angles(-(0.12 + 0.1 * math.sin(t * 3) + roar * 0.7), 0, 0)
			elseif an == "arm" then rot = CFrame.Angles(math.sin(t * 3) * 0.3, 0, 0)
			elseif an == "tail1" then rot = CFrame.Angles(0, math.sin(t * 2) * 0.18, 0)
			elseif an == "tail2" then rot = CFrame.Angles(0, math.sin(t * 2 - 0.6) * 0.3, 0)
			elseif an == "tail3" then rot = CFrame.Angles(0, math.sin(t * 2 - 1.2) * 0.4, 0) end
			r.p.CFrame = base * r.pvt * rot * r.pvt:Inverse() * r.rest
		end
	end
	local wps = { { 0, 38 }, { 32, 28 }, { 0, 20 }, { 0, 0 }, { 0, -20 }, { -32, -28 }, { 0, -38 }, { 32, -28 }, { 0, -20 }, { 0, 0 }, { 0, 20 }, { -32, 28 } }
	local pos, hd, wi, tclock = a.Center + Vector3.new(0, 0, 38), Vector3.new(0, 0, -1), 2, 0
	trexRoot = CFrame.lookAt(pos, pos + hd)
	pose(trexRoot, 0)
	trexReset = function()
		pos, hd, wi = a.Center + Vector3.new(0, 0, 38), Vector3.new(0, 0, -1), 2
	end
	RunS.Heartbeat:Connect(function(dt)
		if not dinoActive then return end
		tclock = tclock + dt
		local w = wps[wi]
		local d = Vector3.new(a.Center.X + w[1] - pos.X, 0, a.Center.Z + w[2] - pos.Z)
		if d.Magnitude < 2.5 then
			wi = wi % #wps + 1
		else
			hd = hd:Lerp(d.Unit, math.min(1, dt * 2.5))
			hd = (hd.Magnitude > 0.01) and hd.Unit or d.Unit
			pos = pos + hd * 9 * dt
		end
		trexRoot = CFrame.lookAt(pos, pos + hd)
		pose(trexRoot, tclock)
	end)
	for k = -40, 40, 10 do
		a.Spawns[#a.Spawns + 1] = a.Center + Vector3.new(k, 4, 44)
		a.Spawns[#a.Spawns + 1] = a.Center + Vector3.new(k, 4, -44)
	end
end

-- 4) ARENA DOS BOTS (so para partidas com bots, fora do sorteio)
do
