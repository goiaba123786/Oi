-- barracas organizadas em fileira
local function stall(name, x, z, colA, colB)
	local counter = P(map, "Counter", Vector3.new(12, 3.5, 4), CFrame.new(x, 1.75, z), WOOD2)
	P(map, "CounterTop", Vector3.new(13, 0.6, 5), CFrame.new(x, 3.8, z), WOOD)
	for _, dx in ipairs({ -6, 6 }) do P(map, "Post", Vector3.new(1, 10, 1), CFrame.new(x + dx, 5, z - 1.5), WOOD2) end
	for i = 0, 5 do
		P(map, "Awning", Vector3.new(2.2, 0.8, 8), CFrame.new(x - 5.5 + i * 2.2, 10.4, z + 0.5) * CFrame.Angles(math.rad(-10), 0, 0), (i % 2 == 0) and colA or colB)
	end
	local board = P(map, "Sign", Vector3.new(11, 3, 0.8), CFrame.new(x, 13.2, z - 1.5), Color3.fromRGB(255, 244, 214))
	sign(board, name, 0, 320, 80)
	return counter
end
